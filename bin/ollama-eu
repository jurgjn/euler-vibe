# singularity shell --nv --cleanenv --home $(pwd)/home:/home --bind $(pwd)/workspace:/workspace --bind $OLLAMA_MODELS:/home/.ollama/models ollama-eu.sif
# singularity shell --nv --cleanenv --home $(pwd):/home --bind $OLLAMA_MODELS:/home/.ollama/models ollama-eu.sif
