#!/usr/bin/env bash
# euler-claude starts Claude Code sandboxed by euler-sandbox in its own tmux
# session 'euler-claude-<dir>', one session per directory. If the current
# directory already has a session, switch to it instead (arguments are then
# ignored).
#
# - Claude's login/config (~/.claude, ~/.claude.json) is mounted from
#   home/euler-claude in this repo, shared by all projects; your git name
#   and email from ~/.gitconfig are passed in as GIT_AUTHOR_NAME etc. The rest
#   of $HOME is part of the project's overlay below. Only $PWD, the extra
#   mounts below and this repo (read-only, without home/; $EUVIBE_DIR in the
#   container) are visible from the host
# - .euler-vibe/mounts in $PWD - project-specific bind mounts, applied by
#   euler-sandbox
# - .euler-vibe/sandboxes/euler-claude.sif in $PWD - project-specific image
#   used instead of sandboxes/euler-claude.sif; needs claude on PATH (run
#   with singularity exec)
# - Either image is (re)built first if a .def next to it (euler-claude.def)
#   has changed since the image was built, see euler-sandbox --update-image
# - .euler-vibe/overlays/euler-claude.img in $PWD - persistent overlay over the
#   image's root filesystem (e.g. for apt-get/npm -g installs), created if
#   missing with a size of $EUVIBE_OVERLAY_SIZE (GiB, default 50)
# - Arguments are passed to singularity exec, e.g. --bind /some/dir
#
# TODO:
# - pass extra args to claude itself, not just to singularity
# - per-project CLAUDE_CONFIG_DIR so every project's claude config is separate
# - physically move the container def + build into a separate function to have
#   it at the bottom of the script?

set -euo pipefail

# Used to infer locations of config/sandboxes/models
export EUVIBE_DIR=$(dirname $(dirname $(realpath $0)))

SCRIPT_NAME=$(basename "$(realpath "$0")")

# One tmux session per directory, named after this script and the directory.
# Sessions are found by the session option @euvibe_session ("claude:<full
# path>") and addressed by their id ($N); the name is only for display, as two
# directories can share a basename (the second one gets a -2 suffix etc.).
SESSION_KEY="claude:$PWD"

attach() {
    if [[ -n "${TMUX:-}" ]]; then
        # Already inside tmux: switch instead of nesting
        tmux switch-client -t "$1"
    else
        tmux attach-session -t "$1"
    fi
}

# Resume this directory's session if it is still there. Attach only after the
# loop: inside it, stdin is the session list rather than the terminal.
sid=
while IFS=$'\t' read -r id key name; do
    if [[ "$key" == "$SESSION_KEY" ]]; then
        sid=$id
        break
    fi
done < <(tmux list-sessions -F $'#{session_id}\t#{@euvibe_session}\t#{session_name}' 2>/dev/null || true)
if [[ -n "$sid" ]]; then
    if (( $# > 0 )); then
        echo "Resumed existing session '$name'; ignored arguments: $*" >&2
    fi
    attach "$sid"
    exit 0
fi

# tmux turns '.' and ':' into '_' in session names, so do the same here or
# exact-match targets would miss
SESSION_NAME="$SCRIPT_NAME-${PWD##*/}"
SESSION_NAME=${SESSION_NAME//[.:]/_}
if tmux has-session -t "=$SESSION_NAME" 2>/dev/null; then
    i=2
    while tmux has-session -t "=$SESSION_NAME-$i" 2>/dev/null; do
        i=$((i + 1))
    done
    SESSION_NAME=$SESSION_NAME-$i
fi

CLAUDE_IMAGE=$EUVIBE_DIR/sandboxes/euler-claude.sif
# A project can bring its own image, e.g. euler-claude.sif plus extra
# packages, or the .def to build it from
PROJECT_IMAGE=$PWD/.euler-vibe/sandboxes/euler-claude
if [[ -f "$PROJECT_IMAGE.sif" || -f "$PROJECT_IMAGE.def" ]]; then
    CLAUDE_IMAGE=$PROJECT_IMAGE.sif
fi
OVERLAY_IMAGE=$PWD/.euler-vibe/overlays/$SCRIPT_NAME.img
# Check .euler-vibe/mounts, rebuild the image and create the overlay here
# rather than in the tmux session, which would close without a trace on errors
"$EUVIBE_DIR/bin/euler-sandbox" --check-mounts --update-image "$CLAUDE_IMAGE" \
    --overlay-image "$OVERLAY_IMAGE"
if [[ ! -f "$CLAUDE_IMAGE" ]]; then
    echo "image not found: $CLAUDE_IMAGE" >&2
    exit 1
fi
CLAUDE_HOME=$EUVIBE_DIR/home/euler-claude
mkdir -p "$CLAUDE_HOME/.claude"
chmod 700 "$CLAUDE_HOME"
# Bind mounts need an existing source; Claude reads an empty object as no config
if [[ ! -e "$CLAUDE_HOME/.claude.json" ]]; then
    echo '{}' > "$CLAUDE_HOME/.claude.json"
fi
# Your git identity from ~/.gitconfig for commits in the container
GIT_ENV=()
git_name=$(git config --global user.name 2>/dev/null || true)
git_email=$(git config --global user.email 2>/dev/null || true)
if [[ -n "$git_name" ]]; then
    GIT_ENV+=(--env GIT_AUTHOR_NAME="$git_name" --env GIT_COMMITTER_NAME="$git_name")
fi
if [[ -n "$git_email" ]]; then
    GIT_ENV+=(--env GIT_AUTHOR_EMAIL="$git_email" --env GIT_COMMITTER_EMAIL="$git_email")
fi
# This repo, read-only at the same path (e.g. for debugging the sandbox), with
# home/ hidden behind an empty directory (cache/home-mask) as it holds logins
# of all agents. Skipped if $PWD is in the repo: a later read-only mount of the
# repo would hide the read-write $PWD
EUVIBE_MOUNT=(--env EUVIBE_DIR="$EUVIBE_DIR")
if [[ "$PWD/" != "$EUVIBE_DIR/"* ]]; then
    mkdir -p "$EUVIBE_DIR/cache/home-mask"
    EUVIBE_MOUNT+=(
        --bind "$EUVIBE_DIR:$EUVIBE_DIR:ro"
        --bind "$EUVIBE_DIR/cache/home-mask:$EUVIBE_DIR/home:ro"
    )
fi

# euler-sandbox adds the throwaway /tmp and mounts $PWD and .euler-vibe/mounts
CMD=(
    "$EUVIBE_DIR/bin/euler-sandbox" --no-home
    --overlay-image "$OVERLAY_IMAGE"
    exec
    --nv
    --bind "$CLAUDE_HOME/.claude:$HOME/.claude"
    --bind "$CLAUDE_HOME/.claude.json:$HOME/.claude.json"
    "${GIT_ENV[@]}"
    "${EUVIBE_MOUNT[@]}"
    "$@"
    --env TERM="${TERM:-xterm-256color}"
    --env DISABLE_AUTOUPDATER=1
    --env TMPDIR=/tmp
    "$CLAUDE_IMAGE" claude --dangerously-skip-permissions
)

# A tmux server that is already running would otherwise give the session its
# own (possibly stale) environment; euler-sandbox puts its overlay in $TMPDIR
ENV=(-e PATH="$PATH" -e TMPDIR="${TMPDIR:-/tmp}")

sid=$(tmux new-session -d -P -F '#{session_id}' \
          -s "$SESSION_NAME" -n claude -c "$PWD" "${ENV[@]}" "${CMD[@]}")
tmux set-option -t "$sid" @euvibe_session "$SESSION_KEY"
tmux set-option -w -t "$sid" automatic-rename off
tmux set-option -w -t "$sid" allow-rename off
attach "$sid"
