#!/usr/bin/env bash
# euler-claude starts Claude Code sandboxed by euler-sandbox in window
# 'claude:<dir>' of the tmux session named after this script (euler-claude),
# one window per directory. If the current directory already has a window,
# switch to it instead (arguments are then ignored).
#
# - Home is home/euler-claude in this repo (persists login/config across runs);
#   only $PWD and the extra mounts below are visible from the host
# - .euler-vibe/mounts in $PWD - project-specific bind mounts, applied by
#   euler-sandbox
# - .euler-vibe/euler-claude.sif in $PWD - project-specific image used instead
#   of sandboxes/euler-claude.sif; needs claude on PATH (run with singularity
#   exec)
# - Arguments are passed to singularity exec, e.g. --bind /some/dir
#
# TODO:
# - pass extra args to claude itself, not just to singularity
# - per-project CLAUDE_CONFIG_DIR so every project's claude config is separate
# - physically move the container def + build into a separate function to have
#   it at the bottom of the script?

set -euo pipefail

# Used to infer locations of config/sandboxes/models
export EUVIBE_DIR=$(dirname $(dirname $(realpath $0)))

SCRIPT_NAME=$(basename "$(realpath "$0")")

# One tmux session named after this script, with one window per directory.
# tmux turns '.' and ':' into '_' in session names, so do the same here or
# exact-match targets would miss. Windows are found by the window option
# @euvibe_key ("claude:<full path>"); the visible name "claude:<basename>"
# is only for display, as two directories can share a basename.
TMUX_SESSION=${SCRIPT_NAME//[.:]/_}
WINDOW_KEY="claude:$PWD"
WINDOW_NAME="claude:${PWD##*/}"

attach() {
    tmux select-window -t "$1"
    if [[ -n "${TMUX:-}" ]]; then
        # Already inside tmux: switch instead of nesting
        tmux switch-client -t "=$TMUX_SESSION"
    else
        tmux attach-session -t "=$TMUX_SESSION"
    fi
}

# Resume this directory's window if it is still there. Attach only after the
# loop: inside it, stdin is the window list rather than the terminal.
wid=
if tmux has-session -t "=$TMUX_SESSION" 2>/dev/null; then
    while IFS=$'\t' read -r id key; do
        if [[ "$key" == "$WINDOW_KEY" ]]; then
            wid=$id
            break
        fi
    done < <(tmux list-windows -t "=$TMUX_SESSION" -F $'#{window_id}\t#{@euvibe_key}')
fi
if [[ -n "$wid" ]]; then
    if (( $# > 0 )); then
        echo "Resumed existing window '$WINDOW_NAME'; ignored arguments: $*" >&2
    fi
    attach "$wid"
    exit 0
fi

CLAUDE_IMAGE=$EUVIBE_DIR/sandboxes/euler-claude.sif
# A project can bring its own image, e.g. euler-claude.sif plus extra packages
if [[ -f "$PWD/.euler-vibe/euler-claude.sif" ]]; then
    CLAUDE_IMAGE=$PWD/.euler-vibe/euler-claude.sif
fi
# Fail here rather than in the tmux window, which would close without a trace
if [[ ! -f "$CLAUDE_IMAGE" ]]; then
    echo "image not found: $CLAUDE_IMAGE" >&2
    exit 1
fi
CLAUDE_HOME=$EUVIBE_DIR/home/euler-claude
mkdir -p "$CLAUDE_HOME"
chmod 700 "$CLAUDE_HOME"

# Check .euler-vibe/mounts here, as errors in the tmux window would be lost
"$EUVIBE_DIR/bin/euler-sandbox" --check-mounts

# euler-sandbox adds the throwaway /tmp + overlay and mounts $PWD and
# .euler-vibe/mounts
CMD=(
    "$EUVIBE_DIR/bin/euler-sandbox" --home "$CLAUDE_HOME:$HOME"
    exec
    --nv
    "$@"
    --env TERM="${TERM:-xterm-256color}"
    --env DISABLE_AUTOUPDATER=1
    --env TMPDIR=/tmp
    "$CLAUDE_IMAGE" claude --dangerously-skip-permissions
)

# A tmux server that is already running would otherwise give the window its
# own (possibly stale) environment; euler-sandbox puts its overlay in $TMPDIR
ENV=(-e PATH="$PATH" -e TMPDIR="${TMPDIR:-/tmp}")

if tmux has-session -t "=$TMUX_SESSION" 2>/dev/null; then
    wid=$(tmux new-window -d -P -F '#{window_id}' \
              -t "=$TMUX_SESSION:" -n "$WINDOW_NAME" -c "$PWD" "${ENV[@]}" "${CMD[@]}")
else
    wid=$(tmux new-session -d -P -F '#{window_id}' \
              -s "$TMUX_SESSION" -n "$WINDOW_NAME" -c "$PWD" "${ENV[@]}" "${CMD[@]}")
fi
tmux set-option -w -t "$wid" @euvibe_key "$WINDOW_KEY"
tmux set-option -w -t "$wid" automatic-rename off
tmux set-option -w -t "$wid" allow-rename off
attach "$wid"
