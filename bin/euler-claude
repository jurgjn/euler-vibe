#!/usr/bin/env bash
# euler-claude starts Claude Code sandboxed by singularity in window
# 'claude:<dir>' of the tmux session named after this script (euler-claude),
# one window per directory. If the current directory already has a window,
# switch to it instead (arguments are then ignored).
#
# - Home is home/euler-claude in this repo (persists login/config across runs);
#   only $PWD and the extra mounts below are visible from the host
# - .euvibe/mounts in $PWD - project-specific bind mounts, see
#   read_project_mounts
# - .euvibe/<script name>.sif in $PWD (e.g. euler-claude.sif) - project-specific
#   image used instead of images/claude-eu.sif; needs claude on PATH (run with
#   singularity exec)
# - Arguments are passed to singularity exec, e.g. --bind /some/dir
#
# TODO:
# - pass extra args to claude itself, not just to singularity
# - per-project CLAUDE_CONFIG_DIR so every project's claude config is separate
# - physically move the container def + build into a separate function to have
#   it at the bottom of the script?

set -euo pipefail

# Read extra bind mounts for this project from .euvibe/mounts in the current
# directory into the array EUVIBE_MOUNT_ARGS (as --bind <spec> pairs). One
# mount per line in singularity's --bind format, src[:dst[:opts]], e.g.
#     /cluster/work/beltrao/jjaenes/data           # same path inside
#     ~/scratch:/scratch:ro
#     $WORK/26.06_pstQTL::ro                       # empty dst: same path, ro
#     ${DATA}/*.parquet::ro                        # one mount per match
# Blank lines and # comments are ignored. $VAR and ${VAR} are replaced from
# the environment (an unset variable is an error), a leading ~ expands to
# $HOME, a relative src is taken relative to the project directory and an
# empty dst means the same path as src. A src containing *, ? or [ is a glob:
# each match is mounted at its own path (dst must be empty), and no matches
# is fine. Any other src must exist, rather than letting singularity abort.
read_project_mounts() {
    EUVIBE_MOUNT_ARGS=()
    local file="$PWD/.euvibe/mounts" line out name src dst opts m
    local var_re='\$\{([A-Za-z_][A-Za-z0-9_]*)\}|\$([A-Za-z_][A-Za-z0-9_]*)'
    local -a matches
    [[ -f "$file" ]] || return 0
    while IFS= read -r line || [[ -n "$line" ]]; do
        line=${line%%#*}
        line=${line#"${line%%[![:space:]]*}"}
        line=${line%"${line##*[![:space:]]}"}
        [[ -n "$line" ]] || continue

        out=
        while [[ "$line" =~ $var_re ]]; do
            name=${BASH_REMATCH[1]:-${BASH_REMATCH[2]}}
            if [[ ! -v $name ]]; then
                echo "$file: \$$name is not set" >&2
                return 1
            fi
            out+=${line%%"${BASH_REMATCH[0]}"*}${!name}
            line=${line#*"${BASH_REMATCH[0]}"}
        done
        line=$out$line

        IFS=: read -r src dst opts <<< "$line"
        [[ "$src" == "~" || "$src" == "~/"* ]] && src=$HOME${src:1}
        [[ "$src" == /* ]] || src=$PWD/$src

        if [[ "$src" == *[*?[]* ]]; then
            if [[ -n "$dst" ]]; then
                echo "$file: glob $src needs an empty dst (src::opts)" >&2
                return 1
            fi
            mapfile -t matches < <(compgen -G "$src" || true)
        elif [[ -e "$src" ]]; then
            matches=("$src")
        else
            echo "$file: $src does not exist" >&2
            return 1
        fi

        for m in "${matches[@]}"; do
            EUVIBE_MOUNT_ARGS+=(--bind "$m:${dst:-$m}${opts:+:$opts}")
        done
    done < "$file"
}

# Used to infer locations of config/images/models
export EUVIBE_DIR=$(dirname $(dirname $(realpath $0)))

SCRIPT_NAME=$(basename "$(realpath "$0")")

# One tmux session named after this script, with one window per directory.
# tmux turns '.' and ':' into '_' in session names, so do the same here or
# exact-match targets would miss. Windows are found by the window option
# @euvibe_key ("claude:<full path>"); the visible name "claude:<basename>"
# is only for display, as two directories can share a basename.
TMUX_SESSION=${SCRIPT_NAME//[.:]/_}
WINDOW_KEY="claude:$PWD"
WINDOW_NAME="claude:${PWD##*/}"

attach() {
    tmux select-window -t "$1"
    if [[ -n "${TMUX:-}" ]]; then
        # Already inside tmux: switch instead of nesting
        tmux switch-client -t "=$TMUX_SESSION"
    else
        tmux attach-session -t "=$TMUX_SESSION"
    fi
}

# Resume this directory's window if it is still there. Attach only after the
# loop: inside it, stdin is the window list rather than the terminal.
wid=
if tmux has-session -t "=$TMUX_SESSION" 2>/dev/null; then
    while IFS=$'\t' read -r id key; do
        if [[ "$key" == "$WINDOW_KEY" ]]; then
            wid=$id
            break
        fi
    done < <(tmux list-windows -t "=$TMUX_SESSION" -F $'#{window_id}\t#{@euvibe_key}')
fi
if [[ -n "$wid" ]]; then
    if (( $# > 0 )); then
        echo "Resumed existing window '$WINDOW_NAME'; ignored arguments: $*" >&2
    fi
    attach "$wid"
    exit 0
fi

CLAUDE_IMAGE=$EUVIBE_DIR/images/claude-eu.sif
# A project can bring its own image, e.g. claude-eu.sif plus extra packages
if [[ -f "$PWD/.euvibe/$SCRIPT_NAME.sif" ]]; then
    CLAUDE_IMAGE=$PWD/.euvibe/$SCRIPT_NAME.sif
fi
CLAUDE_HOME=$EUVIBE_DIR/home/euler-claude
mkdir -p "$CLAUDE_HOME"
chmod 700 "$CLAUDE_HOME"
OVERLAY_DIR="$TMPDIR/euler-vibe-claude_overlay.$$"
mkdir -p "$OVERLAY_DIR"/overlay "$OVERLAY_DIR"/tmp

read_project_mounts

CMD=(
    singularity exec
    --nv
    --contain
    --cleanenv
    --home "$CLAUDE_HOME:$HOME"
    --overlay "$OVERLAY_DIR"/overlay
    --bind "$OVERLAY_DIR"/tmp:/tmp
    --bind "$PWD:$PWD"
    "${EUVIBE_MOUNT_ARGS[@]}"
    "$@"
    --cwd "$PWD"
    --env TERM="${TERM:-xterm-256color}"
    --env DISABLE_AUTOUPDATER=1
    --env TMPDIR=/tmp
    "$CLAUDE_IMAGE" claude --dangerously-skip-permissions
)

if tmux has-session -t "=$TMUX_SESSION" 2>/dev/null; then
    wid=$(tmux new-window -d -P -F '#{window_id}' \
              -t "=$TMUX_SESSION:" -n "$WINDOW_NAME" -c "$PWD" "${CMD[@]}")
else
    wid=$(tmux new-session -d -P -F '#{window_id}' \
              -s "$TMUX_SESSION" -n "$WINDOW_NAME" -c "$PWD" "${CMD[@]}")
fi
tmux set-option -w -t "$wid" @euvibe_key "$WINDOW_KEY"
tmux set-option -w -t "$wid" automatic-rename off
tmux set-option -w -t "$wid" allow-rename off
attach "$wid"

#rm -rf "$OVERLAY_DIR"
