#!/usr/bin/env bash

set -euo pipefail

# Used to infer locations of config/sandboxes/models
export EUVIBE_DIR=$(dirname $(dirname $(realpath $0)))
export EUVIBE_PORT=${EUVIBE_PORT:-27182}
export EUVIBE_MODEL=${EUVIBE_MODEL:-Qwen/Qwen3.8-27B-FP8}
#export EUVIBE_MODEL=${EUVIBE_MODEL:-bytkim/Qwen3.8-27B-pi-FP8}
# Name the server exposes the model as (sglang --served-model-name); also what
# pi selects with --model and reports as $PI_MODEL, e.g. in commit trailers
export EUVIBE_SERVED_MODEL_NAME=${EUVIBE_SERVED_MODEL_NAME:-qwen3.8-27b}

export EUVIBE_SERVE=${EUVIBE_SERVE:-$EUVIBE_DIR/serve-local/euler-qwen27b}
# Default session name is the script's file name. tmux turns '.' and ':' into
# '_' in session names, so do the same here or exact-match targets would miss.
_script_name=${0##*/}
export EUVIBE_TMUX_SESSION=${EUVIBE_TMUX_SESSION:-${_script_name//[.:]/_}}
export EUVIBE_START_TIMEOUT=${EUVIBE_START_TIMEOUT:-900}   # seconds to wait for /health

export OPENAI_BASE_URL="http://localhost:$EUVIBE_PORT/v1"
export OPENAI_API_KEY="no-key"

export EUVIBE_CONTEXT_LENGTH=${EUVIBE_CONTEXT_LENGTH:-262144}            # sglang --context-length
export EUVIBE_PI_CONTEXT_WINDOW=${EUVIBE_PI_CONTEXT_WINDOW:-$((EUVIBE_CONTEXT_LENGTH * 7 / 8))}  # what pi is told

usage() {
    cat <<EOF
Usage:
    euler-qwen27b [pi args]  run pi against the local server in window
                             'pi:<dir>' of tmux session '$EUVIBE_TMUX_SESSION' for
                             the current directory; if that window already
                             exists, switch to it instead (pi args are then
                             ignored)
    euler-qwen27b start      start sglang in window 'serve' of tmux session
                             '$EUVIBE_TMUX_SESSION'
    euler-qwen27b stop       stop the server and close its window
    euler-qwen27b help       show this message

All windows live in one tmux session:   tmux attach -t $EUVIBE_TMUX_SESSION
Switch windows with Ctrl-b w (or Ctrl-b n / Ctrl-b p); detach with Ctrl-b d.
Run euler-qwen27b in the same directory to resume its pi window.

Extra bind mounts for a project go in .euler-vibe/mounts (one
src[:dst[:opts]] per line, # comments allowed); they apply when its pi window
is created. If .euler-vibe/sandboxes/euler-qwen27b.sif exists, it is used
instead of sandboxes/euler-qwen27b.sif; its %runscript must start pi with the
given args, as in sandboxes/euler-qwen27b.def:
    exec pi "\$@"
Either image is (re)built when a new pi window is created if the .def next to
it (euler-qwen27b.def) has changed since the image was built; a project can
also bring just .euler-vibe/sandboxes/euler-qwen27b.def.

pi's config (~/.pi) is mounted from home/euler-qwen27b in this repo, shared
by all projects; your git name and email from ~/.gitconfig are passed in as
GIT_AUTHOR_NAME etc. This repo is mounted read-only at the same path
(\$EUVIBE_DIR in the container), without home/. Other writes to the
container's file system, including the rest of \$HOME (e.g. apt-get,
npm -g or pip --user installs, caches), persist in
.euler-vibe/overlays/euler-qwen27b.img, created if missing with a size of
\$EUVIBE_OVERLAY_SIZE (GiB, default 50).
EOF
}

# ---------------------------------------------------------------------------
# tmux helpers
#
# Windows are identified by a window option @euvibe_key ("serve" or
# "pi:<full path>") and addressed by their window id (@N). The visible window
# name ("serve", "pi:<basename>") is only for display: names containing ':' or
# '.' cannot be used reliably in tmux targets, and two directories can share a
# basename.
# ---------------------------------------------------------------------------

session_exists() {
    tmux has-session -t "=$EUVIBE_TMUX_SESSION" 2>/dev/null
}

# Print the id of the window whose @euvibe_key equals $1 (nothing if none).
find_window() {
    local key=$1 id k
    session_exists || return 0
    while IFS=$'\t' read -r id k; do
        if [[ "$k" == "$key" ]]; then
            echo "$id"
            return 0
        fi
    done < <(tmux list-windows -t "=$EUVIBE_TMUX_SESSION" \
                  -F $'#{window_id}\t#{@euvibe_key}' 2>/dev/null)
    return 0
}

window_exists() {
    [[ -n "$1" ]] && tmux display-message -p -t "$1" '#{window_id}' >/dev/null 2>&1
}

# True once the window's command has exited (kept around by remain-on-exit)
pane_dead() {
    [[ "$(tmux display-message -p -t "$1" '#{pane_dead}' 2>/dev/null)" == 1 ]]
}

# create_window <name> <key> [new-window options...] [command]
# Creates the session if needed, otherwise adds a window to it. Prints the id.
create_window() {
    local name=$1 key=$2
    shift 2
    local wid
    if session_exists; then
        wid=$(tmux new-window -d -P -F '#{window_id}' \
                  -t "=$EUVIBE_TMUX_SESSION:" -n "$name" "$@")
    else
        wid=$(tmux new-session -d -P -F '#{window_id}' \
                  -s "$EUVIBE_TMUX_SESSION" -n "$name" "$@")
    fi
    tmux set-option -w -t "$wid" @euvibe_key "$key"
    tmux set-option -w -t "$wid" automatic-rename off
    tmux set-option -w -t "$wid" allow-rename off
    echo "$wid"
}

attach_window() {
    tmux select-window -t "$1"
    if [[ -n "${TMUX:-}" ]]; then
        # Already inside tmux: switch instead of nesting
        tmux switch-client -t "=$EUVIBE_TMUX_SESSION"
    else
        tmux attach-session -t "=$EUVIBE_TMUX_SESSION"
    fi
}

require_tmux() {
    command -v tmux >/dev/null || { echo "tmux not found in PATH" >&2; exit 1; }
}

# ---------------------------------------------------------------------------
# pi
# ---------------------------------------------------------------------------

# Print the image to run pi in. A project can bring its own image, e.g.
# euler-qwen27b.sif plus extras, or the .def to build it from.
pi_image() {
    local project="$PWD/.euler-vibe/sandboxes/euler-qwen27b"
    if [[ -f "$project.sif" || -f "$project.def" ]]; then
        echo "$project.sif"
    else
        echo "$EUVIBE_DIR/sandboxes/euler-qwen27b.sif"
    fi
}

# Print the persistent overlay image for this project. Named after the script
# itself, not a symlink to it, so it is the same inside and outside tmux.
pi_overlay_image() {
    echo "$PWD/.euler-vibe/overlays/$(basename "$(realpath "$0")").img"
}

# Entry point for `euler-qwen27b [args]`: create the per-directory window if
# needed, then attach to it.
cmd_pi() {
    require_tmux

    local key="pi:$PWD"
    local name="pi:${PWD##*/}"
    [[ "$name" == "pi:" ]] && name="pi:/"

    local wid
    wid=$(find_window "$key")

    if [[ -n "$wid" ]]; then
        if (( $# > 0 )); then
            echo "Resumed existing window '$name'; ignored arguments: $*" >&2
        fi
    else
        # Check .euler-vibe/mounts, rebuild the image and create the overlay
        # here rather than in the window, so their output stays in the terminal
        "$EUVIBE_DIR/bin/euler-sandbox" --check-mounts --update-image "$(pi_image)" \
            --overlay-image "$(pi_overlay_image)"

        # Re-invoke this script inside tmux. Variables are passed explicitly
        # because a tmux server that is already running would otherwise give
        # the new window its own (possibly stale) environment.
        local inner
        inner=$(printf '%q ' "$(realpath "$0")" __pi "$@")
        wid=$(create_window "$name" "$key" -c "$PWD" \
                  -e PATH="$PATH" \
                  -e TMPDIR="${TMPDIR:-/tmp}" \
                  -e EUVIBE_PORT="$EUVIBE_PORT" \
                  -e EUVIBE_MODEL="$EUVIBE_MODEL" \
                  -e EUVIBE_SERVED_MODEL_NAME="$EUVIBE_SERVED_MODEL_NAME" \
                  -e EUVIBE_SERVE="$EUVIBE_SERVE" \
                  -e EUVIBE_TMUX_SESSION="$EUVIBE_TMUX_SESSION" \
                  -e EUVIBE_CONTEXT_LENGTH="$EUVIBE_CONTEXT_LENGTH" \
                  -e EUVIBE_PI_CONTEXT_WINDOW="$EUVIBE_PI_CONTEXT_WINDOW" \
                  "$inner")
    fi

    attach_window "$wid"
}

# Runs inside the tmux window: render the config and start the container.
cmd_pi_run() {
    # On a clean exit the window closes, so the next euler-qwen27b starts fresh.
    # On any failure (pi itself, or an earlier set -e / set -u abort), keep
    # the output visible until the user has read it.
    trap 'rc=$?; if (( rc != 0 )); then
              echo
              echo "pi window failed with status $rc. Press Enter to close this window."
              read -r || true
          fi' EXIT

    # pi's config dir (~/.pi/agent in the container), shared by all projects
    local pi_home="$EUVIBE_DIR/home/euler-qwen27b"
    local agent_dir="$pi_home/.pi/agent"
    mkdir -p "$agent_dir"
    chmod 700 "$pi_home"

    # stripJsonComments is Pi’s own small helper in utils/json.ts, not the npm package. Its docstring says it strips // line comments and trailing commas from JSON, leaving string literals untouched.
    envsubst '
      $OPENAI_BASE_URL
      $OPENAI_API_KEY
      $EUVIBE_SERVED_MODEL_NAME
      $EUVIBE_PI_CONTEXT_WINDOW
    ' < "$EUVIBE_SERVE/models.template.jsonc" \
    > "$agent_dir/models.json"

    # Copied verbatim (no envsubst): it refers to pi's own $PI_MODEL/$PI_PROVIDER
    if [[ -f "$EUVIBE_SERVE/APPEND_SYSTEM.md" ]]; then
        cp "$EUVIBE_SERVE/APPEND_SYSTEM.md" "$agent_dir/APPEND_SYSTEM.md"
    fi

    local settings="$agent_dir/settings.json"
    if [[ ! -e "$settings" ]]; then
        cat > "$settings" <<'EOF'
{ "compaction": { "enabled": true, "reserveTokens": 49152, "keepRecentTokens": 20000 } }
EOF
    fi

    echo "$agent_dir/models.json":
    cat "$agent_dir/models.json"

    local image
    image=$(pi_image)
    echo "Image: $image"

    # Your git identity from ~/.gitconfig for commits in the container
    local git_env=() git_name git_email
    git_name=$(git config --global user.name 2>/dev/null || true)
    git_email=$(git config --global user.email 2>/dev/null || true)
    if [[ -n "$git_name" ]]; then
        git_env+=(--env GIT_AUTHOR_NAME="$git_name" --env GIT_COMMITTER_NAME="$git_name")
    fi
    if [[ -n "$git_email" ]]; then
        git_env+=(--env GIT_AUTHOR_EMAIL="$git_email" --env GIT_COMMITTER_EMAIL="$git_email")
    fi
    # This repo, read-only at the same path (e.g. for debugging the sandbox),
    # with home/ hidden behind an empty directory as it holds logins of all
    # agents. Skipped if $PWD is in the repo: a later read-only mount of the
    # repo would hide the read-write $PWD
    local euvibe_mount=(--env EUVIBE_DIR="$EUVIBE_DIR")
    if [[ "$PWD/" != "$EUVIBE_DIR/"* ]]; then
        mkdir -p "$EUVIBE_DIR/cache/empty"
        euvibe_mount+=(
            --bind "$EUVIBE_DIR:$EUVIBE_DIR:ro"
            --bind "$EUVIBE_DIR/cache/empty:$EUVIBE_DIR/home:ro"
        )
    fi

    # euler-sandbox adds the throwaway /tmp and mounts $PWD and
    # .euler-vibe/mounts; the rest of $HOME is part of the overlay
    "$EUVIBE_DIR/bin/euler-sandbox" --no-home \
        --overlay-image "$(pi_overlay_image)" run \
        --nv \
        --bind "$pi_home/.pi:$HOME/.pi" \
        "${git_env[@]}" \
        "${euvibe_mount[@]}" \
        --env EUVIBE_MODEL="$EUVIBE_MODEL" \
        --env OPENAI_BASE_URL="$OPENAI_BASE_URL" \
        --env OPENAI_API_KEY="$OPENAI_API_KEY" \
        --env TMPDIR=/tmp \
        "$image" \
        --provider sglang --model "$EUVIBE_SERVED_MODEL_NAME" --thinking medium "$@"
}

# ---------------------------------------------------------------------------
# sglang server
# ---------------------------------------------------------------------------

cmd_serve_start() {
    require_tmux

    local wid
    wid=$(find_window serve)

    if [[ -n "$wid" ]]; then
        if pane_dead "$wid"; then
            echo "Removing stale window 'serve' (server had exited)"
            tmux kill-window -t "$wid"
        else
            echo "Server already running in window 'serve' of tmux session '$EUVIBE_TMUX_SESSION'"
            return 0
        fi
    fi

    local env=(
        -e EUVIBE_DIR="$EUVIBE_DIR"
        -e EUVIBE_PORT="$EUVIBE_PORT"
        -e EUVIBE_MODEL="$EUVIBE_MODEL"
        -e EUVIBE_SERVED_MODEL_NAME="$EUVIBE_SERVED_MODEL_NAME"
        -e EUVIBE_SERVE="$EUVIBE_SERVE"
        -e EUVIBE_CONTEXT_LENGTH="$EUVIBE_CONTEXT_LENGTH"
        -e OPENAI_API_KEY="$OPENAI_API_KEY"
    )

    # Start with a plain shell, enable remain-on-exit, then swap in serve.sh,
    # so even an instant crash leaves its output readable. The variables are
    # given to respawn-pane too, since new-window -e only applies to the
    # window's first process.
    echo "Starting $EUVIBE_SERVE/serve.sh in window 'serve' of tmux session '$EUVIBE_TMUX_SESSION'"
    wid=$(create_window serve serve "${env[@]}")
    tmux set-option -w -t "$wid" remain-on-exit on
    tmux respawn-pane -k -t "$wid" "${env[@]}" "$EUVIBE_SERVE/serve.sh"

    echo -n "Waiting for http://localhost:$EUVIBE_PORT/health "
    local deadline=$((SECONDS + EUVIBE_START_TIMEOUT))
    until curl -sf -o /dev/null "http://localhost:$EUVIBE_PORT/health"; do
        if ! window_exists "$wid"; then
            echo; echo "tmux window 'serve' disappeared" >&2; exit 1
        fi
        if pane_dead "$wid"; then
            echo
            echo "serve.sh exited with status $(tmux display-message -p -t "$wid" '#{pane_dead_status}'). Last output:" >&2
            tmux capture-pane -p -t "$wid" -S -40 >&2
            exit 1
        fi
        if (( SECONDS >= deadline )); then
            echo; echo "Timed out after ${EUVIBE_START_TIMEOUT}s. Check with: tmux attach -t $EUVIBE_TMUX_SESSION (window 'serve')" >&2
            exit 1
        fi
        echo -n .
        sleep 5
    done
    echo " ready"
}

cmd_serve_stop() {
    local wid
    wid=$(find_window serve)

    if [[ -z "$wid" ]]; then
        echo "No window 'serve' in tmux session '$EUVIBE_TMUX_SESSION'; nothing to stop"
        return 0
    fi

    if ! pane_dead "$wid"; then
        echo "Sending Ctrl-C to sglang..."
        tmux send-keys -t "$wid" C-c

        for ((i = 0; i < 30; i++)); do
            pane_dead "$wid" && break
            sleep 1
        done

        if ! pane_dead "$wid"; then
            # The pane process is a session leader, so its PID is also the
            # process group ID; this also reaches sglang's worker processes.
            local pid
            pid=$(tmux display-message -p -t "$wid" '#{pane_pid}')
            echo "Still running after 30s, sending SIGTERM to process group $pid"
            kill -TERM -- "-$pid" 2>/dev/null || true
            sleep 5
            pane_dead "$wid" || kill -KILL -- "-$pid" 2>/dev/null || true
        fi
    fi

    # If this was the last window, tmux closes the session as well
    tmux kill-window -t "$wid"
    echo "Server stopped"
}

main() {
    local cmd="${1:-}"

    if [[ $# -gt 0 ]]; then
        shift
    fi

    case "$cmd" in
        start)
            cmd_serve_start "$@"
            ;;
        stop)
            cmd_serve_stop "$@"
            ;;
        help)
            usage
            ;;
        __pi)
            # Internal: invoked inside the pi tmux window
            cmd_pi_run "$@"
            ;;
        "")
            cmd_pi
            ;;
        *)
            # Anything else is passed through to pi
            cmd_pi "$cmd" "$@"
            ;;
    esac
}

main "$@"
