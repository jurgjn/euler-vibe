#!/usr/bin/env -S uv run --script
# /// script
# requires-python = ">=3.9"
# dependencies = [
#     "duckdb>=1.1",
#     "foldcomp>=0.0.7",
#     "gemmi>=0.6",
#     "requests>=2.31",
# ]
# ///
"""
Download the high-confidence subset of the NVIDIA / AlphaFold DB dimer release (all
species) as Foldcomp-compressed chains, packed into one squashfs image.

Metadata: https://ftp.ebi.ac.uk/pub/databases/alphafold/collaborations/nvda/
Models:   https://alphafold.ebi.ac.uk/files/AF-<id>-model_v1.cif

Step 1  Download homodimer_metadata.csv (~6.0 GB), heterodimer_metadata.csv
        (~2.5 GB) and README.txt. Downloads resume after interruption.

Step 2  Select models that pass the high-confidence criterion from the latest
        bioRxiv version of Han et al., "AlphaFold Database expands to
        proteome-scale quaternary structures", doi:10.64898/2026.03.27.714458:

            ipSAE_max   = max(ipSAE_AB,   ipSAE_BA)   >= 0.60   and
            pDockQ2_max = max(pDockQ2_AB, pDockQ2_BA) >= 0.23

        This is the criterion behind the heterodimer CSV's passes_quality_threshold
        column (the homodimer CSV has no such column), and the set of models AFDB
        hosts individually. Both directional scores are read from the metadata and
        the max is taken here, identically for homo- and heterodimers. Rows with a
        missing or non-finite score are rejected. One Parquet manifest per complex
        type is written, containing every original metadata column plus the derived
        scores, AFDB's confidence label, the model URL and the paths in the image.

Step 3  Fetch the selected models from AFDB one mmCIF at a time, in batches of
        about --batch-size models. Each mmCIF is converted in memory to
        AF-<id>-model_v1_A.fcz and AF-<id>-model_v1_B.fcz (Foldcomp handles single
        chains only) in staging/; the mmCIF is not kept. After each batch the staged
        files are appended to afdb_nvda_hc.squashfs and deleted, so disk use and file
        count stay at about one batch. The ~49 TB of tar archives on the FTP are not
        touched: AFDB serves the same files (checked byte-for-byte on a sample).

Step 4  Once every model has been fetched, append README.txt, the manifests,
        selection_summary.json and absent.tsv (selected models AFDB doesn't serve,
        or that couldn't be converted) to the root of the image.

Layout of the image. mksquashfs can only add new names to the root directory of an
existing image (a clashing name is renamed, not merged), so models are grouped in
top-level directories that each go in whole, in one batch: the model ID without its
last 4 digits, e.g. AF-000000006577/AF-0000000065774308-model_v1_A.fcz. A directory
in the image therefore means that all of its models were fetched, and an interrupted
run resumes from the image itself. Batches with failed downloads are left in
staging/ and retried by the next run.

Mount the image with `squashfuse afdb_nvda_hc.squashfs DIR` or bind it into a
container with `singularity exec --bind afdb_nvda_hc.squashfs:/afdb:image-src=/`.

Foldcomp is lossy: on a test sample, atoms moved by up to ~0.8 A and pLDDT (kept as
the B-factor) by up to ~0.1, and each chain took ~1.6 kB. Everything in the mmCIF
besides coordinates, residue names and pLDDT is dropped. Read the files with
`foldcomp.decompress(open(path, "rb").read())` or `foldcomp decompress`.

Dependencies are declared in the inline metadata block at the top of this file
(PEP 723), so `uv run` installs them into a cached, isolated environment on
first use; nothing needs to be installed by hand. Without uv:
`pip install duckdb foldcomp gemmi requests` and run it with python as usual.
Steps 3 and 4 need mksquashfs and unsquashfs (squashfs-tools >= 4.6) on PATH.

Examples
    # Run from the directory the download should go to (or pass --out DIR)

    # Metadata + manifests only; prints counts
    pull-afdb_nvda_hc --dry-run

    # Small end-to-end test: one batch of ~1000 models
    pull-afdb_nvda_hc --batch-size 1000 --max-batches 1

    # Full run (safe to interrupt and restart)
    pull-afdb_nvda_hc --workers 8
"""

from __future__ import annotations

import argparse
import fcntl
import json
import logging
import os
import random
import shutil
import subprocess
import sys
import threading
import time
from concurrent.futures import ThreadPoolExecutor, as_completed
from pathlib import Path

import duckdb
import foldcomp
import gemmi
import requests

BASE_URL = "https://ftp.ebi.ac.uk/pub/databases/alphafold/collaborations/nvda"
FILES_URL = "https://alphafold.ebi.ac.uk/files"
# complex type -> metadata file
SOURCES = {
    "homodimer": "homodimer_metadata.csv",
    "heterodimer": "heterodimer_metadata.csv",
}
README_NAME = "README.txt"
REQUIRED_COLUMNS = ["modelEntityId", "ipSAE_AB", "ipSAE_BA", "pDockQ2_AB", "pDockQ2_BA"]

# Latest preprint version: joint cutoff on direction-maximised scores.
IPSAE_MIN = 0.60
PDOCKQ2_MIN = 0.23

MODEL_SUFFIX = "-model_v1"  # + .cif on AFDB, + _<chain>.fcz in the image
CHAINS = ("A", "B")         # every model is a dimer
BUCKET_DIGITS = 4           # top-level directory = model ID minus this many digits
IMAGE_NAME = "afdb_nvda_hc.squashfs"
ABSENT_NAME = "absent.tsv"
RETRY_STATUS = {408, 425, 429, 500, 502, 503, 504}
# AFDB answers 403 to some User-Agents (e.g. curl's); requests' default is accepted.
USER_AGENT = f"python-requests/{requests.__version__} (pull-afdb_nvda_hc)"

log = logging.getLogger("afdb_nvda_hc")
STOP = threading.Event()
_tls = threading.local()


# --------------------------------------------------------------------------- #
# HTTP helpers
# --------------------------------------------------------------------------- #
class Fatal(Exception):
    """An error that would hit every request (e.g. access denied): stop the run."""


def _session() -> requests.Session:
    """One keep-alive session per thread."""
    s = getattr(_tls, "session", None)
    if s is None:
        s = requests.Session()
        s.headers.update({"User-Agent": USER_AGENT, "Accept-Encoding": "identity"})
        _tls.session = s
    return s


def _reset_session() -> None:
    s = getattr(_tls, "session", None)
    if s is not None:
        s.close()
    _tls.session = None


def _backoff(attempt: int, cap: float = 120.0) -> None:
    time.sleep(min(cap, 2.0 ** attempt) * (0.5 + random.random() / 2))


def download_file(url: str, dest: Path, *, retries: int, timeout: float) -> None:
    """Resumable download. Skips the file if the local copy matches the remote size
    and validator (ETag / Last-Modified); restarts if the remote file changed."""
    dest.parent.mkdir(parents=True, exist_ok=True)
    part = dest.with_name(dest.name + ".part")
    vfile = dest.with_name(dest.name + ".validator")

    head = None
    for attempt in range(retries):
        try:
            head = _session().head(url, allow_redirects=True, timeout=timeout)
            if head.status_code in RETRY_STATUS:
                raise IOError(f"HTTP {head.status_code}")
            head.raise_for_status()
            break
        except (requests.RequestException, OSError) as exc:
            _reset_session()
            if attempt == retries - 1:
                raise RuntimeError(f"HEAD {url} failed: {exc}")
            _backoff(attempt)
    total = int(head.headers.get("Content-Length", -1))
    validator = head.headers.get("ETag") or head.headers.get("Last-Modified") or ""
    saved = vfile.read_text().strip() if vfile.exists() else ""

    if dest.exists() and dest.stat().st_size == total and (saved == validator or not validator):
        log.info("up to date: %s (%.2f GB)", dest.name, total / 1e9)
        return
    if dest.exists():
        log.info("remote %s changed; re-downloading", dest.name)
        dest.unlink()
    pos = part.stat().st_size if part.exists() and saved == validator else 0
    if pos == 0 and part.exists():
        part.unlink()
    vfile.write_text(validator)

    log.info("downloading %s (%.2f GB)%s", url, total / 1e9,
             f", resuming at {pos / 1e9:.2f} GB" if pos else "")
    last_log = time.monotonic()
    for attempt in range(retries):
        headers = {}
        if pos:
            headers["Range"] = f"bytes={pos}-"
            if validator:
                headers["If-Range"] = validator
        try:
            with _session().get(url, headers=headers, stream=True, timeout=timeout) as r:
                if r.status_code == 416 and pos == total:
                    break
                if r.status_code == 200:
                    pos, mode = 0, "wb"
                elif r.status_code == 206:
                    mode = "ab"
                else:
                    if r.status_code in RETRY_STATUS:
                        raise IOError(f"HTTP {r.status_code}")
                    r.raise_for_status()
                with open(part, mode) as fh:
                    for chunk in r.iter_content(chunk_size=8 << 20):
                        fh.write(chunk)
                        pos += len(chunk)
                        if time.monotonic() - last_log > 30:
                            last_log = time.monotonic()
                            log.info("  %s: %.2f / %.2f GB", dest.name, pos / 1e9, total / 1e9)
            if total < 0 or pos >= total:
                break
        except (requests.RequestException, OSError) as exc:
            _reset_session()
            if attempt == retries - 1:
                raise RuntimeError(f"download of {url} failed: {exc}")
            log.warning("  %s interrupted at %.2f GB (%s); resuming", dest.name, pos / 1e9, exc)
            _backoff(attempt)
    if total >= 0 and part.stat().st_size != total:
        raise RuntimeError(f"{dest.name}: size {part.stat().st_size} != {total}")
    os.replace(part, dest)
    log.info("done: %s", dest.name)


def fetch_model(url: str, *, retries: int, timeout: float) -> bytes | None:
    """Return the body of url, or None if the server doesn't have it (HTTP 404)."""
    for attempt in range(retries):
        if STOP.is_set():
            raise KeyboardInterrupt
        try:
            r = _session().get(url, timeout=timeout)
            if r.status_code == 200:
                body = r.content
                # Content-Length counts the bytes on the wire, which AFDB sometimes gzips
                # despite "Accept-Encoding: identity"; r.raw.tell() counts the same.
                expected = r.headers.get("Content-Length")
                if expected is not None and r.raw.tell() != int(expected):
                    raise IOError(f"truncated body: {r.raw.tell()} of {expected} bytes")
                return body
            if r.status_code == 404:
                return None
            if r.status_code in (401, 403):
                raise Fatal(f"{url}: HTTP {r.status_code}; AFDB may be blocking this "
                            f"client or network")
            if r.status_code not in RETRY_STATUS:
                raise RuntimeError(f"{url}: HTTP {r.status_code}")
            error: Exception = IOError(f"HTTP {r.status_code}")
        except (requests.RequestException, OSError) as exc:
            error = exc
        _reset_session()
        if attempt == retries - 1:
            raise RuntimeError(f"{url}: {error}")
        log.debug("retrying %s after: %s", url, error)
        _backoff(attempt)
    raise AssertionError("unreachable")


# --------------------------------------------------------------------------- #
# Selection
# --------------------------------------------------------------------------- #
def _lit(value) -> str:
    return "'" + str(value).replace("'", "''") + "'"


def _num(col: str) -> str:
    # NULL for empty / unparsable / NaN / inf. DuckDB sorts NaN above every
    # number, so without isfinite() a NaN score would pass ">= 0.6".
    cast = f'TRY_CAST("{col}" AS DOUBLE)'
    return f"CASE WHEN isfinite({cast}) THEN {cast} END"


def _max2(a: str, b: str) -> str:
    # NULL unless both directions are scored: DuckDB's greatest() skips NULLs,
    # which would let one missing score fall back to the other direction.
    x, y = _num(a), _num(b)
    return f"CASE WHEN {x} IS NOT NULL AND {y} IS NOT NULL THEN greatest({x}, {y}) END"


def select_models(csv_path: Path, ctype: str, manifest: Path, files_url: str,
                  ipsae_min: float, pdockq2_min: float) -> dict:
    con = duckdb.connect()
    src = f"read_csv({_lit(csv_path)}, header=true, all_varchar=true)"
    columns = [r[0] for r in con.execute(f"DESCRIBE SELECT * FROM {src}").fetchall()]
    missing = [c for c in REQUIRED_COLUMNS if c not in columns]
    if missing:
        raise SystemExit(f"{csv_path.name} lacks columns {missing}; the release schema may "
                         f"have changed (see README.txt). Columns found: {columns}")

    scored = f"""
        SELECT *,
            CASE WHEN starts_with(modelEntityId, 'AF-') THEN modelEntityId
                 ELSE 'AF-' || modelEntityId END AS model_id,
            {_max2('ipSAE_AB', 'ipSAE_BA')} AS ipSAE_max,
            {_max2('pDockQ2_AB', 'pDockQ2_BA')} AS pDockQ2_max
        FROM {src}"""
    passes = f"ipSAE_max >= {ipsae_min!r} AND pDockQ2_max >= {pdockq2_min!r}"
    # Paths of the chains' .fcz files in the image
    stem = (f"left(model_id, length(model_id) - {BUCKET_DIGITS}) || '/' || model_id"
            f" || {_lit(MODEL_SUFFIX)}")
    chain_paths = ",\n                ".join(
        f"{stem} || {_lit(f'_{c}.fcz')} AS rel_path_{c}" for c in CHAINS)
    log.info("selecting %ss from %s ...", ctype, csv_path.name)
    tmp = manifest.with_name(manifest.name + ".tmp")
    con.execute(f"""
        COPY (
            SELECT {_lit(ctype)} AS complex_type, *,
                CASE WHEN ipSAE_max >= 0.8 THEN 'very_high'
                     WHEN ipSAE_max >= 0.7 THEN 'confident'
                     WHEN ipSAE_max >= 0.6 THEN 'low'
                     ELSE 'below_afdb_cutoff' END AS afdb_confidence_label,
                {_lit(files_url + '/')} || model_id || {_lit(MODEL_SUFFIX + '.cif')} AS cif_url,
                {chain_paths}
            FROM ({scored})
            WHERE {passes}
            ORDER BY model_id
        ) TO {_lit(tmp)} (FORMAT PARQUET, COMPRESSION ZSTD)""")
    os.replace(tmp, manifest)

    upstream = "passes_quality_threshold" in columns
    flag = "lower(trim(passes_quality_threshold)) IN ('true', 't', '1', 'yes')"
    extra = (f""", count(*) FILTER (WHERE {flag}) AS upstream_flag_pass,
                   count(*) FILTER (WHERE {flag} AND ({passes})) AS upstream_flag_and_ours"""
             if upstream else "")
    row = con.execute(f"""
        SELECT count(*) AS rows,
               count(*) FILTER (WHERE ipSAE_max IS NOT NULL AND pDockQ2_max IS NOT NULL) AS scored,
               count(*) FILTER (WHERE {passes}) AS passing
               {extra}
        FROM ({scored})""").fetchone()
    names = ["rows", "scored", "passing"]
    if upstream:
        names += ["upstream_flag_pass", "upstream_flag_and_ours"]
    summary = dict(zip(names, map(int, row)))
    m = f"read_parquet({_lit(manifest)})"
    summary["selected"] = int(con.execute(f"SELECT count(*) FROM {m}").fetchone()[0])
    summary["by_label"] = dict(con.execute(
        f"SELECT afdb_confidence_label, count(*) FROM {m} GROUP BY 1 ORDER BY 1").fetchall())
    return summary


# --------------------------------------------------------------------------- #
# Conversion
# --------------------------------------------------------------------------- #
class Unconvertible(Exception):
    """A model that can't be stored as .fcz (unexpected chains, unreadable mmCIF)."""


def save_model(cif: bytes, paths: list[Path], model_id: str) -> int:
    """Convert one mmCIF to one .fcz per chain; return the bytes written."""
    if not cif.lstrip().startswith(b"data_"):
        raise Unconvertible("response is not an mmCIF")
    try:
        st = gemmi.make_structure_from_block(gemmi.cif.read_string(cif.decode()).sole_block())
    except (ValueError, RuntimeError, UnicodeDecodeError) as exc:
        raise Unconvertible(f"unreadable mmCIF: {exc}")
    chains = [ch.name for ch in st[0]]
    if tuple(chains) != CHAINS:
        raise Unconvertible(f"expected chains {list(CHAINS)}, found {chains}")
    # foldcomp.compress() parses PDB text only (and aborts on mmCIF), one chain at a time
    blobs = []
    for ch in st[0]:
        one = gemmi.Structure()
        model = gemmi.Model(1)
        model.add_chain(ch)
        one.add_model(model)
        pdb = one.make_pdb_string(gemmi.PdbWriteOptions(minimal=True))
        try:
            blobs.append(foldcomp.compress(f"{model_id}{MODEL_SUFFIX}_{ch.name}", pdb))
        except Exception as exc:
            raise Unconvertible(f"foldcomp failed on chain {ch.name}: {exc}")
    # The last chain is written last, so its file marks the model as complete
    for path, blob in zip(paths, blobs):
        tmp = path.with_name(f"{path.name}.part{threading.get_ident()}")
        tmp.write_bytes(blob)
        os.replace(tmp, path)
    return sum(map(len, blobs))


# --------------------------------------------------------------------------- #
# Squashfs
# --------------------------------------------------------------------------- #
def _squashfs_run(cmd: list[str]) -> None:
    log.debug("running %s", " ".join(cmd))
    r = subprocess.run(cmd, capture_output=True, text=True)
    if r.returncode:
        raise RuntimeError(f"{cmd[0]} failed ({r.returncode}):\n{r.stdout}{r.stderr}")


def image_root(image: Path) -> set[str]:
    """Names in the root directory of the image (empty if there is no image yet)."""
    if not image.exists():
        return set()
    r = subprocess.run(["unsquashfs", "-l", "-max-depth", "1", "-d", "", str(image)],
                       capture_output=True, text=True, check=True)
    return {line[1:] for line in r.stdout.splitlines() if line.startswith("/")}


def recover_image(image: Path) -> None:
    """Undo an append that was killed half-way, using mksquashfs' recovery file."""
    for rec in sorted(image.parent.glob(f"squashfs_recovery_{image.name}_*")):
        log.warning("restoring %s from %s (an earlier append was interrupted)", image, rec)
        _squashfs_run(["mksquashfs", "-", str(image), "-recover", str(rec)])
        rec.unlink()


def append_to_image(image: Path, sources: list[Path], processors: int) -> None:
    """Add each source (file or directory) to the root of the image, creating it if needed."""
    create = not image.exists()
    # A new image is built under a temporary name, so a killed run leaves no broken image;
    # an interrupted append is undone by recover_image().
    dest = image.with_name(image.name + ".tmp") if create else image
    if create:
        dest.unlink(missing_ok=True)
    cmd = ["mksquashfs", *map(str, sources), str(dest), "-keep-as-directory",
           "-no-duplicates", "-all-root", "-no-xattrs", "-no-progress", "-quiet",
           "-recovery-path", str(image.parent)]
    if create:  # fixed at creation; appends inherit them
        cmd += ["-comp", "zstd", "-Xcompression-level", "19", "-b", "1M", "-root-mode", "0555"]
    if processors:
        cmd += ["-processors", str(processors)]
    _squashfs_run(cmd)
    if create:
        os.replace(dest, image)


# --------------------------------------------------------------------------- #
# Batches
# --------------------------------------------------------------------------- #
def plan_buckets(manifests: list[Path], done: set[str]) -> dict[str, list[tuple]]:
    """Models still to fetch, grouped by top-level directory, in ID order."""
    con = duckdb.connect()
    files = "[" + ", ".join(_lit(m) for m in manifests) + "]"
    rows = con.execute(f"""
        SELECT model_id, complex_type, cif_url, {", ".join(f"rel_path_{c}" for c in CHAINS)}
        FROM read_parquet({files}, union_by_name=true)
        ORDER BY model_id""").fetchall()
    buckets: dict[str, list[tuple]] = {}
    for model_id, ctype, url, *rel_paths in rows:
        bucket = rel_paths[0].split("/", 1)[0]
        if bucket not in done:
            buckets.setdefault(bucket, []).append((model_id, ctype, url, rel_paths))
    return buckets


def make_batches(buckets: dict[str, list[tuple]], batch_size: int) -> list[list[str]]:
    batches, cur, n = [], [], 0
    for bucket, models in buckets.items():
        cur.append(bucket)
        n += len(models)
        if n >= batch_size:
            batches.append(cur)
            cur, n = [], 0
    if cur:
        batches.append(cur)
    return batches


def fetch_one(model: tuple, staging: Path, http: dict) -> tuple[str, int, str | None]:
    """Fetch and convert one model; return (status, bytes written, detail)."""
    model_id, _, url, rel_paths = model
    paths = [staging / p for p in rel_paths]
    try:
        cif = fetch_model(url, **http)
    except (Fatal, KeyboardInterrupt):
        raise
    except Exception as exc:
        return "error", 0, str(exc)
    if cif is None:
        return "not_in_afdb", 0, None
    try:
        return "downloaded", save_model(cif, paths, model_id), None
    except Unconvertible as exc:
        return "unconvertible", 0, str(exc)


class Progress:
    def __init__(self, total: int):
        self.total, self.start, self.last = total, time.monotonic(), 0.0
        self.counts = {"downloaded": 0, "present": 0, "not_in_afdb": 0,
                       "unconvertible": 0, "error": 0}
        self.bytes = 0

    def report(self, force: bool = False) -> None:
        now = time.monotonic()
        if not force and now - self.last < 30:
            return
        self.last = now
        c = self.counts
        n = sum(c.values()) - c["present"]
        rate = n / max(now - self.start, 1e-9)
        left = self.total - sum(c.values())
        log.info("models %d/%d | new %d, present %d, not in AFDB %d, unconvertible %d, "
                 "errors %d | %.2f GB .fcz | %.1f models/s, ETA %.1f h",
                 sum(c.values()), self.total, c["downloaded"], c["present"],
                 c["not_in_afdb"], c["unconvertible"], c["error"], self.bytes / 1e9,
                 rate, left / rate / 3600 if rate else float("nan"))


def run_batch(batch: list[str], buckets: dict[str, list[tuple]], args, pool,
              ledger, progress: Progress) -> list[str]:
    """Fetch every model of the batch into staging/; return the buckets with no errors."""
    staging = args.out / "staging"
    http = {"retries": args.retries, "timeout": args.timeout}
    failed: set[str] = set()
    futures = {}
    for bucket in batch:
        (staging / bucket).mkdir(parents=True, exist_ok=True)
        for model in buckets[bucket]:
            if (staging / model[3][-1]).exists():
                progress.counts["present"] += 1
            else:
                futures[pool.submit(fetch_one, model, staging, http)] = (bucket, model)
    for fut in as_completed(futures):
        bucket, (model_id, ctype, url, _) = futures[fut]
        status, nbytes, detail = fut.result()
        progress.counts[status] += 1
        progress.bytes += nbytes
        if status != "downloaded":
            ledger(model_id, ctype, url, status, detail)
        if status == "error":
            failed.add(bucket)
            log.warning("%s: %s", model_id, detail)
        elif status == "unconvertible":
            log.warning("%s: %s", model_id, detail)
        progress.report()
    return [b for b in batch if b not in failed]


def write_absent(args, manifests: list[Path]) -> Path:
    """Selected models that are not in the image, with the reason."""
    out = args.out / ABSENT_NAME
    ledger = args.out / "ledger.jsonl"
    con = duckdb.connect()
    files = "[" + ", ".join(_lit(m) for m in manifests) + "]"
    if ledger.exists() and ledger.stat().st_size:
        con.execute(f"""
            CREATE VIEW absent AS
            SELECT m.model_id, m.complex_type, l.status, l.detail
            FROM read_parquet({files}, union_by_name=true) m
            JOIN (SELECT model_id, arg_max(status, time) AS status, arg_max(detail, time) AS detail
                  FROM read_json({_lit(ledger)}, format='newline_delimited',
                                 columns={{model_id: 'VARCHAR', status: 'VARCHAR',
                                           detail: 'VARCHAR', time: 'BIGINT'}})
                  WHERE status IN ('not_in_afdb', 'unconvertible')
                  GROUP BY model_id) l USING (model_id)
            ORDER BY m.model_id""")
    else:
        con.execute("""CREATE VIEW absent AS SELECT NULL::VARCHAR AS model_id,
                       NULL::VARCHAR AS complex_type, NULL::VARCHAR AS status,
                       NULL::VARCHAR AS detail WHERE false""")
    con.execute(f"COPY absent TO {_lit(out)} (FORMAT CSV, DELIMITER '\t', HEADER)")
    n = con.execute("SELECT count(*) FROM absent").fetchone()[0]
    log.info("%d selected models are not in the image (see %s)", n, out.name)
    return out


def build_image(manifests: list[Path], args) -> int:
    image = args.out / IMAGE_NAME
    staging = args.out / "staging"
    recover_image(image)
    root = image_root(image)
    if README_NAME in root:
        log.info("%s is complete; nothing to do", image)
        return 0

    buckets = plan_buckets(manifests, root)
    all_batches = make_batches(buckets, args.batch_size)
    batches = all_batches[: args.max_batches] if args.max_batches else all_batches
    total = sum(map(len, buckets.values()))
    log.info("%d models in %d directories still to fetch (%d already in %s), in %d batches "
             "of ~%d models, with %d workers", total, len(buckets), len(root), image.name,
             len(all_batches), args.batch_size, args.workers)
    # Staged directories the current selection doesn't ask for (e.g. left from an
    # earlier selection) would never be appended; drop them.
    if staging.exists():
        for d in staging.iterdir():
            if d.name not in buckets:
                log.warning("removing stale %s", d)
                shutil.rmtree(d)

    lock = threading.Lock()
    ledger_fh = open(args.out / "ledger.jsonl", "a", buffering=1)

    def ledger(model_id, ctype, url, status, detail=None):
        rec = {"model_id": model_id, "complex_type": ctype, "url": url,
               "status": status, "time": int(time.time())}
        if detail:
            rec["detail"] = detail
        with lock:
            ledger_fh.write(json.dumps(rec) + "\n")

    progress = Progress(sum(len(buckets[b]) for batch in batches for b in batch))
    unfinished = 0
    pool = ThreadPoolExecutor(max_workers=args.workers)
    try:
        for i, batch in enumerate(batches, 1):
            n = sum(len(buckets[b]) for b in batch)
            log.info("batch %d/%d: %d models in %s%s", i, len(batches), n, batch[0],
                     f" .. {batch[-1]} ({len(batch)} directories)" if len(batch) > 1 else "")
            sealed = run_batch(batch, buckets, args, pool, ledger, progress)
            progress.report(force=True)
            if sealed:
                log.info("appending %d directories to %s", len(sealed), image.name)
                append_to_image(image, [staging / b for b in sealed], args.squashfs_processors)
                for b in sealed:
                    shutil.rmtree(staging / b)
            if len(sealed) < len(batch):
                unfinished += len(batch) - len(sealed)
                log.warning("kept %d directories with failed downloads in %s; re-run to retry",
                            len(batch) - len(sealed), staging)
    except (KeyboardInterrupt, Fatal) as exc:
        STOP.set()
        pool.shutdown(wait=True, cancel_futures=True)
        if isinstance(exc, Fatal):
            log.error("%s", exc)
            return 1
        log.warning("interrupted; staged files are kept (re-run to resume)")
        return 130
    finally:
        ledger_fh.close()
    pool.shutdown()

    if unfinished:
        log.error("%d directories have failed downloads; re-run to retry them", unfinished)
        return 1
    if len(batches) < len(all_batches):
        log.info("stopped after --max-batches %d; re-run to continue", args.max_batches)
        return 0

    # Step 4: everything is in; add the metadata to the root of the image
    finals = [args.out / "metadata" / README_NAME, *manifests,
              args.out / "selection_summary.json", write_absent(args, manifests)]
    log.info("appending %s to %s", ", ".join(f.name for f in finals), image.name)
    append_to_image(image, finals, args.squashfs_processors)
    if staging.exists() and not any(staging.iterdir()):
        staging.rmdir()
    log.info("done: %s (%.2f GB)", image, image.stat().st_size / 1e9)
    return 0


# --------------------------------------------------------------------------- #
# Main
# --------------------------------------------------------------------------- #
def main(argv=None) -> int:
    p = argparse.ArgumentParser(description=__doc__,
                                formatter_class=argparse.RawDescriptionHelpFormatter)
    p.add_argument("--out", type=Path, default=Path("."),
                   help="output directory (default: the current directory)")
    p.add_argument("--ipsae-min", type=float, default=IPSAE_MIN)
    p.add_argument("--pdockq2-min", type=float, default=PDOCKQ2_MIN)
    p.add_argument("--dry-run", action="store_true",
                   help="download metadata and write manifests, but fetch no structures")
    p.add_argument("--workers", type=int, default=8,
                   help="models fetched in parallel (be polite to EBI; default 8)")
    p.add_argument("--batch-size", type=int, default=20000,
                   help="models per batch, rounded up to whole directories; bounds the "
                        "staged files at ~2 per model (default 20000)")
    p.add_argument("--max-batches", type=int, default=0,
                   help="stop after N batches (default: run to completion)")
    p.add_argument("--squashfs-processors", type=int, default=0,
                   help="CPUs mksquashfs may use (default: all)")
    p.add_argument("--skip-metadata-refresh", action="store_true",
                   help="use local metadata CSVs as-is without checking the server")
    p.add_argument("--base-url", default=BASE_URL, help="where the metadata is")
    p.add_argument("--files-url", default=FILES_URL, help="where the models are")
    p.add_argument("--retries", type=int, default=12)
    p.add_argument("--timeout", type=float, default=120)
    p.add_argument("-v", "--verbose", action="store_true")
    args = p.parse_args(argv)

    logging.basicConfig(level=logging.DEBUG if args.verbose else logging.INFO,
                        format="%(asctime)s %(levelname)s %(message)s", datefmt="%H:%M:%S")
    logging.getLogger("urllib3").setLevel(logging.WARNING)
    base, files_url = args.base_url.rstrip("/"), args.files_url.rstrip("/")
    args.out.mkdir(parents=True, exist_ok=True)
    lock_fh = open(args.out / ".pull-afdb_nvda_hc.lock", "w")
    try:
        fcntl.flock(lock_fh, fcntl.LOCK_EX | fcntl.LOCK_NB)
    except BlockingIOError:
        raise SystemExit(f"another pull-afdb_nvda_hc is running in {args.out}")
    meta_dir = args.out / "metadata"
    http = {"retries": args.retries, "timeout": args.timeout}

    # Step 1: metadata
    for name in [README_NAME, *SOURCES.values()]:
        dest = meta_dir / name
        if args.skip_metadata_refresh and dest.exists():
            continue
        download_file(f"{base}/{name}", dest, **http)

    # Step 2: selection (cached unless inputs or thresholds change)
    summary_path = args.out / "selection_summary.json"
    cached = json.loads(summary_path.read_text()) if summary_path.exists() else {}
    manifests, summary = [], {}
    for ctype, csv_name in SOURCES.items():
        csv_path = meta_dir / csv_name
        manifest = args.out / f"manifest_{ctype}.parquet"
        vfile = csv_path.with_name(csv_path.name + ".validator")
        params = {"csv_bytes": csv_path.stat().st_size,
                  "csv_validator": vfile.read_text().strip() if vfile.exists() else "",
                  "files_url": files_url, "bucket_digits": BUCKET_DIGITS,
                  "ipsae_min": args.ipsae_min, "pdockq2_min": args.pdockq2_min}
        prev = cached.get(ctype, {})
        if manifest.exists() and prev.get("params") == params:
            log.info("reusing %s", manifest.name)
            summary[ctype] = prev
        else:
            if (args.out / IMAGE_NAME).exists() and prev.get("params") != params:
                raise SystemExit(
                    f"the {ctype} selection changed since {IMAGE_NAME} was started "
                    f"(was {prev.get('params')}, now {params}). Move {IMAGE_NAME} away to "
                    f"start a new image, or restore the old metadata / options "
                    f"(--skip-metadata-refresh).")
            summary[ctype] = {"params": params, **select_models(
                csv_path, ctype, manifest, files_url, args.ipsae_min, args.pdockq2_min)}
        manifests.append(manifest)
        s = summary[ctype]
        log.info("%s: %d of %d models pass (ipSAE_max >= %s, pDockQ2_max >= %s); labels %s",
                 ctype, s["selected"], s["rows"], args.ipsae_min, args.pdockq2_min,
                 s["by_label"])
        if "upstream_flag_pass" in s:
            log.info("%s: upstream passes_quality_threshold=%d, agreeing with this selection: %d",
                     ctype, s["upstream_flag_pass"], s["upstream_flag_and_ours"])
    summary_path.write_text(json.dumps(summary, indent=2) + "\n")

    n_sel = sum(summary[t]["selected"] for t in SOURCES)
    log.info("total selected: %d models (~%.0f GB as .fcz at ~3.3 kB each; ~%.0f GB of "
             "mmCIF to download at ~130 kB each)", n_sel, n_sel * 3.3e3 / 1e9,
             n_sel * 130e3 / 1e9)
    if args.dry_run:
        return 0

    # Steps 3 and 4: structures, then metadata, into the image
    for tool in ("mksquashfs", "unsquashfs"):
        if shutil.which(tool) is None:
            raise SystemExit(f"{tool} not found on PATH (squashfs-tools >= 4.6)")
    return build_image(manifests, args)


if __name__ == "__main__":
    sys.exit(main())
