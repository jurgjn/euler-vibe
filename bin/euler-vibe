#!/usr/bin/env bash

set -euo pipefail

# Used to infer locations of config/images/models
export EU_VIBE_DIR=$(dirname $(dirname $(realpath $0)))
export EU_VIBE_PORT=${EU_VIBE_PORT:-27182}
export EU_VIBE_LOCAL_PORT=27183
export EU_VIBE_MODEL=${EU_VIBE_MODEL:-deepseek-ai/DeepSeek-V4-Flash-0731}

# Script run by serve_local; bare file names are looked up in serve/
export EU_VIBE_SERVE_LOCAL=${EU_VIBE_SERVE_LOCAL:-Qwen3.8-27B_rtx_4090_llama.sh}
export EU_API_KEY="no-api"

usage() {
    cat <<EOF
Usage:
    euler-vibe <command> [args...]

Coding agents (run in a tmux session named after the current directory):
    claude          Start Claude Code in a sandboxed container
    pi              Start pi against the local llama server (starts it if needed)

Models & serving:
    list            List downloaded models
    pull <repo>     Download a model from Hugging Face into models/
    serve [sbatch-args...]
                    Submit a Slurm job serving \$EU_VIBE_MODEL
    serve_local     Start the local llama server in tmux session 'serve_local'
                    (script: \$EU_VIBE_SERVE_LOCAL, default $EU_VIBE_SERVE_LOCAL)
    status          Show serve jobs, SSH tunnel and API settings
    scancel         Cancel the serve job

Client setup (eval the output in your shell):
    activate        Print exports + SSH tunnel command for the serve job
    deactivate      Print command to close the SSH tunnel

Examples:
    euler-vibe pull Qwen/Qwen3.6-27B
    euler-vibe serve --time=00:10:00
    eval "\$(euler-vibe activate)"

tmux cheat sheet:
    tmux ls                         List sessions
    Ctrl-b then d                   Detach from current session
    tmux attach -t <session>        Reattach (e.g. serve_local)
    tmux kill-session -t <session>  Kill a session (or Ctrl-b : kill-session)

EOF
}

cmd_claude() {
    CLAUDE_IMAGE=$EU_VIBE_DIR/images/claude-eu.sif
    CLAUDE_HOME=$EU_VIBE_DIR/home/claude-eu
    mkdir -p "$CLAUDE_HOME"
    chmod 700 "$CLAUDE_HOME"
    OVERLAY_DIR="$TMPDIR/euler-vibe-claude_overlay.$$"
    mkdir -p "$OVERLAY_DIR"/overlay "$OVERLAY_DIR"/tmp
    SCREEN_FILE="$OVERLAY_DIR/last_screen.txt"
    tmux new-session -s "$(basename "$PWD")" -n claude singularity exec \
        --nv \
        --contain \
        --cleanenv \
        --home "$CLAUDE_HOME:$HOME" \
        --overlay "$OVERLAY_DIR"/overlay \
        --bind "$OVERLAY_DIR"/tmp:/tmp \
        --bind "$PWD:$PWD" \
        --cwd "$PWD" \
        --env TERM="${TERM:-xterm-256color}" \
        --env DISABLE_AUTOUPDATER=1 \
        "$CLAUDE_IMAGE" claude --dangerously-skip-permissions "$@" \
        \; set-option -w remain-on-exit on \
        \; set-hook pane-died "capture-pane -e -J ; save-buffer '$SCREEN_FILE' ; delete-buffer ; kill-session" \
        || true

    # Print what was on screen when claude exited, minus trailing blank lines
    if [[ -f "$SCREEN_FILE" ]]; then
        awk 'NF {for (; n > 0; n--) print ""; print; next} {n++}' "$SCREEN_FILE"
    fi
    rm -rf "$OVERLAY_DIR"
}

cmd_pi() {
    cmd_serve_local
    PI_HOME=$EU_VIBE_DIR/home/pi-eu
    OVERLAY_DIR="$TMPDIR/euler-vibe.$$"
    mkdir -p "$OVERLAY_DIR"/overlay "$OVERLAY_DIR"/tmp
    tmux new-session -s "$(basename "$PWD")" -n pi singularity run \
        --nv \
        --cleanenv \
        --containall \
        --env EU_VIBE_URL="http://localhost:$EU_VIBE_PORT" \
        --env EU_API_KEY="no-key" \
        --env EU_VIBE_MODEL="Qwen3.8-27B-UD-Q6_K_XL" \
        --cwd "$PWD" \
        --home "$PI_HOME:$HOME" \
        --overlay "$OVERLAY_DIR"/overlay \
        --bind "$OVERLAY_DIR"/tmp:/tmp \
        --bind "$PWD:$PWD" \
        $EU_VIBE_DIR/images/pi-eu.sif \
        "$@"
}

cmd_list() {
    cd $EU_VIBE_DIR/models
    du -h -d 2 . | awk -F"/" 'NF==3'
}

cmd_pull() {
    mkdir -p $EU_VIBE_DIR/models
    singularity run \
        --cwd=$EU_VIBE_DIR/models \
        --bind $EU_VIBE_DIR/models \
        $EU_VIBE_DIR/images/git_latest.sif \
        lfs clone https://huggingface.co/"$@" "$@"
}

cmd_serve() {
    mkdir -p $EU_VIBE_DIR/logs
    export EULER_VIBE_LOGS="$EU_VIBE_DIR/logs/serve-%j.out"
    sbatch --output=$EULER_VIBE_LOGS --error=$EULER_VIBE_LOGS "$@" $EU_VIBE_DIR/serve/dsv4-flash_pro_6000.sbatch
}

cmd_serve_local() {
    local script=$EU_VIBE_SERVE_LOCAL
    [[ $script == */* ]] || script=$EU_VIBE_DIR/serve/$script
    if ! tmux has-session -t serve_local 2>/dev/null; then
        # tmux sessions inherit the server's environment, so pass vars explicitly
        tmux new-session -d -s serve_local "$(printf '%q ' env \
            EU_VIBE_DIR="$EU_VIBE_DIR" EU_VIBE_PORT="$EU_VIBE_PORT" "$script")"
        echo "Started session serve_local"
    else
        echo "Session serve_local is already running"
    fi
    echo Attach: tmux attach -t serve_local
    echo Detach: Ctrl-b then d
}

cmd_scancel() {
    EU_VIBE_SERVE_JOBID=$(squeue --format="%.18i %.12P %.128j %.8T %.16M %.16l %40R" | awk '$3 ~ /^euler-vibe/ {print $1}')
    echo EU_VIBE_SERVE_JOBID is $EU_VIBE_SERVE_JOBID
    scancel $EU_VIBE_SERVE_JOBID
}

cmd_status() {
    squeue --format="%.18i %.12P %.128j %.8T %.16M %.16l %40R" | awk 'NR==1 || $3 ~ /^euler-vibe/' | column -t --table-right 1,5,6
    echo

    EU_VIBE_SERVE_JOBID=$(squeue --format="%.18i %.12P %.128j %.8T %.16M %.16l %40R" | awk '$3 ~ /^euler-vibe/ {print $1}')
    export HEAD_NAME=$(scontrol show hostnames $(squeue -j $EU_VIBE_SERVE_JOBID -h -o "%N") | head -n 1)
    export BASE_URL="http://$HEAD_NAME:8000/v1/chat/completions"
    export EU_VIBE_LOCAL_PORT=27183
    echo SSH tunnel:
    echo ssh -N -L $EU_VIBE_LOCAL_PORT:$HEAD_NAME:$EU_VIBE_PORT euler.ethz.ch
    echo 
    echo OpenAI API:
    echo export OPENAI_API_BASE="http://localhost:$EU_VIBE_LOCAL_PORT/v1"
    echo export OPENAI_API_KEY=
    echo 
    echo Anthropic API:
    echo export ANTHROPIC_BASE_URL="http://localhost:$EU_VIBE_LOCAL_PORT/"
    echo export ANTHROPIC_API_KEY=
    echo export ANTHROPIC_AUTH_TOKEN=
    echo export ANTHROPIC_DEFAULT_OPUS_MODEL=$EU_VIBE_MODEL
    echo export ANTHROPIC_DEFAULT_SONNET_MODEL=$EU_VIBE_MODEL
    echo export ANTHROPIC_DEFAULT_HAIKU_MODEL=$EU_VIBE_MODEL
    echo
    #echo ssh -N -L 8000:$HEAD_NAME:8000 euler.ethz.ch
    # curl -s https://localhost:12345/v1/chat/completions -H "Content-Type: application/json" -d '{"model": "Qwen/Qwen3.6-27B", "messages": [{"role": "user", "content": "Write a haiku about protein-protein interactions"}]}' | jq .

    #echo Asking for haiku:
    #curl -s http://${HEAD_NAME}:8000/v1/chat/completions \
    #    -H "Content-Type: application/json" \
    #    -d '{"model": "Qwen/Qwen3.6-27B-FP8", "messages": [{"role": "user", "content": "Write a haiku about protein-protein interactions"}]}' \
    #    | jq .
    
}

cmd_activate() {
    EU_VIBE_SERVE_JOBID=$(squeue --format="%.18i %.12P %.128j %.8T %.16M %.16l %40R" | awk '$3 ~ /^euler-vibe/ {print $1}')
    export HEAD_NAME=$(scontrol show hostnames $(squeue -j $EU_VIBE_SERVE_JOBID -h -o "%N") | head -n 1)
    echo export OPENAI_API_BASE="http://localhost:$EU_VIBE_LOCAL_PORT/v1"
    echo export OPENAI_API_KEY=
    echo export ANTHROPIC_BASE_URL="http://localhost:$EU_VIBE_LOCAL_PORT/"
    echo export ANTHROPIC_API_KEY=
    echo export ANTHROPIC_AUTH_TOKEN=
    echo export ANTHROPIC_DEFAULT_OPUS_MODEL=$EU_VIBE_MODEL
    echo export ANTHROPIC_DEFAULT_SONNET_MODEL=$EU_VIBE_MODEL
    echo export ANTHROPIC_DEFAULT_HAIKU_MODEL=$EU_VIBE_MODEL
    echo pgrep -f \"ssh -f -N -L $EU_VIBE_LOCAL_PORT:$HEAD_NAME:$EU_VIBE_PORT\" '>' /dev/null '||' ssh -f -N -L $EU_VIBE_LOCAL_PORT:$HEAD_NAME:$EU_VIBE_PORT euler.ethz.ch
}

cmd_deactivate() {
    echo pkill -f \"ssh -f -N -L $EU_VIBE_LOCAL_PORT\"
}

main() {
    local cmd="${1:-}"

    if [[ $# -gt 0 ]]; then
        shift
    fi

    case "$cmd" in
        claude)
            cmd_claude "$@"
            ;;
        pi)
            cmd_pi "$@"
            ;;
        activate)
            cmd_activate "$@"
            ;;
        deactivate)
            cmd_deactivate "$@"
            ;;
        list)
            cmd_list "$@"
            ;;
        pull)
            cmd_pull "$@"
            ;;
        serve)
            cmd_serve "$@"
            ;;
        serve_local)
            cmd_serve_local "$@"
            ;;
        scancel)
            cmd_scancel "$@"
            ;;
        status)
            cmd_status "$@"
            ;;
        -h|--help|"")
            usage
            ;;
        *)
            echo "Error: unknown command '$cmd'" >&2
            echo
            usage
            exit 1
            ;;
    esac
}

main "$@"
