#!/usr/bin/env bash

set -euo pipefail

# Used to infer locations of config/images/models
EU_VIBE_DIR=$(dirname $(dirname $(realpath $0)))
echo EU_VIBE_DIR is $EU_VIBE_DIR

usage() {
    cat <<EOF
Usage:
    euler-vibe <command> [args...]

Commands:
    list    List available models
    pull    Download model from Hugging Face

Examples:
    euler-vibe pull Qwen/Qwen3.6-27B

EOF
}

cmd_list() {
    cd $EU_VIBE_DIR/models
    du -h -d 2 . | awk -F"/" 'NF==3'
}

cmd_pull() {
    mkdir -p $EU_VIBE_DIR/models
    singularity run \
        --cwd=$EU_VIBE_DIR/models \
        --bind $EU_VIBE_DIR/models \
        $EU_VIBE_DIR/images/git_latest.sif \
        lfs clone https://huggingface.co/"$@" "$@"
}

main() {
    local cmd="${1:-}"

    if [[ $# -gt 0 ]]; then
        shift
    fi

    case "$cmd" in
        list)
            cmd_list "$@"
            ;;
        pull)
            cmd_pull "$@"
            ;;
        -h|--help|"")
            usage
            ;;
        *)
            echo "Error: unknown command '$cmd'" >&2
            echo
            usage
            exit 1
            ;;
    esac
}

main "$@"
