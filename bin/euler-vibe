#!/usr/bin/env bash

set -euo pipefail

# Used to infer locations of config/serve-sandboxes/models
export EUVIBE_DIR=$(dirname $(dirname $(realpath $0)))
export EUVIBE_PORT=${EUVIBE_PORT:-27182}
export EUVIBE_LOCAL_PORT=27183
export EUVIBE_MODEL=${EUVIBE_MODEL:-Qwen/Qwen3.8-27B-FP8}

# Model setup used by serve_local/pi: a directory with serve.sh (starts vllm/llama)
# and models.json (pi config); bare names are looked up in serve/
export EUVIBE_SERVE_LOCAL=${EUVIBE_SERVE_LOCAL:-Qwen3.8-27B_rtx_4090:2_sglang}
export EU_API_KEY="no-api"

# Extra singularity/apptainer args for the claude/pi containers, e.g. per-project
# read-only mounts: EUVIBE_APPTAINER_ARGS="--bind /cluster/work/foo:/cluster/work/foo:ro"
# (split on whitespace, so paths containing spaces are not supported)
read -ra EUVIBE_APPTAINER_ARGS_ARRAY <<< "${EUVIBE_APPTAINER_ARGS:-}"

# Paperpile library from bin/pget, mounted read-only into claude if present
export EUVIBE_PAPERPILE_DIR=${EUVIBE_PAPERPILE_DIR:-$EUVIBE_DIR/paperpile}
if [[ -d $EUVIBE_PAPERPILE_DIR ]]; then
    EUVIBE_APPTAINER_ARGS_ARRAY+=(--bind "$EUVIBE_PAPERPILE_DIR:$EUVIBE_PAPERPILE_DIR:ro")
fi

usage() {
    cat <<EOF
Usage:
    euler-vibe <command> [args...]

Coding agents (run in a tmux session named after the current directory):
    claude          Start Claude Code in a sandboxed container
    pi              Start pi against the local server (starts it if needed),
                    using models.json from \$EUVIBE_SERVE_LOCAL
                    (both pass \$EUVIBE_APPTAINER_ARGS to singularity, e.g.
                    EUVIBE_APPTAINER_ARGS="--bind /path/to/data:/path/to/data:ro")

Models & serving:
    list            List downloaded models
    pull <repo>     Download a model from Hugging Face into models/
    serve [sbatch-args...]
                    Submit a Slurm job serving \$EUVIBE_MODEL
    serve_local     Run serve.sh from \$EUVIBE_SERVE_LOCAL in tmux session 'serve_local'
                    (default $EUVIBE_SERVE_LOCAL; available: $(cd "$EUVIBE_DIR/serve" && ls -d */ | tr -d / | tr '\n' ' '))
                    (output also saved to logs/serve_local-<date>-<time>.log)
    status          Show serve jobs, SSH tunnel and API settings
    scancel         Cancel the serve job

Client setup (eval the output in your shell):
    activate        Print exports + SSH tunnel command for the serve job
    deactivate      Print command to close the SSH tunnel

Examples:
    euler-vibe pull Qwen/Qwen3.6-27B
    euler-vibe serve --time=00:10:00
    eval "\$(euler-vibe activate)"

tmux cheat sheet:
    tmux ls                         List sessions
    Ctrl-b then d                   Detach from current session
    tmux attach -t <session>        Reattach (e.g. serve_local)
    tmux kill-session -t <session>  Kill a session (or Ctrl-b : kill-session)

EOF
}

cmd_claude() {
    CLAUDE_IMAGE=$EUVIBE_DIR/sandboxes/euler-claude.sif
    CLAUDE_HOME=$EUVIBE_DIR/home/euler-claude
    mkdir -p "$CLAUDE_HOME"
    chmod 700 "$CLAUDE_HOME"
    OVERLAY_DIR="$TMPDIR/euler-vibe-claude_overlay.$$"
    mkdir -p "$OVERLAY_DIR"/overlay "$OVERLAY_DIR"/tmp
    SCREEN_FILE="$OVERLAY_DIR/last_screen.txt"
    tmux new-session -s "$(basename "$PWD")" -n claude singularity exec \
        --nv \
        --contain \
        --cleanenv \
        --home "$CLAUDE_HOME:$HOME" \
        --overlay "$OVERLAY_DIR"/overlay \
        --bind "$OVERLAY_DIR"/tmp:/tmp \
        --bind "$PWD:$PWD" \
        --cwd "$PWD" \
        --env TERM="${TERM:-xterm-256color}" \
        --env DISABLE_AUTOUPDATER=1 \
        --env TMPDIR=/tmp \
        "${EUVIBE_APPTAINER_ARGS_ARRAY[@]}" \
        "$CLAUDE_IMAGE" claude --dangerously-skip-permissions "$@" \
        \; set-option -w remain-on-exit on \
        \; set-hook pane-died "capture-pane -e -J ; save-buffer '$SCREEN_FILE' ; delete-buffer ; kill-session" \
        || true

    # Print what was on screen when claude exited, minus trailing blank lines
    if [[ -f "$SCREEN_FILE" ]]; then
        awk 'NF {for (; n > 0; n--) print ""; print; next} {n++}' "$SCREEN_FILE"
    fi
    rm -rf "$OVERLAY_DIR"
}

# Wait until the local server lists the model (vllm takes minutes to boot)
wait_for_model() {
    local model=$1 start=$SECONDS
    echo -n "Waiting for $model on port $EUVIBE_PORT"
    until curl -sf -m 5 -H "Authorization: Bearer no-key" "http://localhost:$EUVIBE_PORT/v1/models" \
            | grep -qF "\"$model\""; do
        if ! tmux has-session -t serve_local 2>/dev/null; then
            echo
            echo "Error: session serve_local exited before $model came up" >&2
            exit 1
        fi
        echo -n .
        sleep 5
    done
    echo " ready after $((SECONDS - start))s"
}

cmd_pi_llama() {
    PI_HOME=$EUVIBE_DIR/home/pi-eu
    mkdir -p "$PI_HOME/.pi/agent"

    OVERLAY_DIR="$TMPDIR/euler-vibe.$$"
    mkdir -p "$OVERLAY_DIR"/overlay
    mkdir -p "$OVERLAY_DIR"/tmp

    #tmux new-session -s "$(basename "$PWD")" -n pi singularity run \
    singularity run \
        --nv \
        --cleanenv \
        --containall \
        --env OPENAI_BASE_URL="http://localhost:$EUVIBE_PORT/v1" \
        --env OPENAI_API_KEY="no-key" \
        --env EUVIBE_MODEL="$EUVIBE_MODEL" \
        --cwd "$PWD" \
        --overlay "$OVERLAY_DIR"/overlay \
        --bind "$OVERLAY_DIR"/tmp:/tmp \
        --bind "$PWD:$PWD" \
        --home "$PI_HOME:$HOME" \
        "${EUVIBE_APPTAINER_ARGS_ARRAY[@]}" \
        $EUVIBE_DIR/sandboxes/euler-qwen27b.sif \
        --provider sglang --model "$EUVIBE_MODEL" "$@"
}

cmd_pi_sglang() {
    PI_HOME=$EUVIBE_DIR/home/pi-eu
    mkdir -p "$PI_HOME/.pi/agent"

    OVERLAY_DIR="$TMPDIR/euler-vibe.$$"
    mkdir -p "$OVERLAY_DIR"/overlay
    mkdir -p "$OVERLAY_DIR"/tmp

    #tmux new-session -s "$(basename "$PWD")" -n pi singularity run \
    singularity run \
        --nv \
        --cleanenv \
        --containall \
        --env OPENAI_BASE_URL="http://localhost:$EUVIBE_PORT/v1" \
        --env OPENAI_API_KEY="no-key" \
        --env EUVIBE_MODEL="$EUVIBE_MODEL" \
        --cwd "$PWD" \
        --overlay "$OVERLAY_DIR"/overlay \
        --bind "$OVERLAY_DIR"/tmp:/tmp \
        --bind "$PWD:$PWD" \
        --home "$PI_HOME:$HOME" \
        "${EUVIBE_APPTAINER_ARGS_ARRAY[@]}" \
        $EUVIBE_DIR/sandboxes/euler-qwen27b.sif \
        --provider sglang --model "$EUVIBE_MODEL" "$@"
}

cmd_list() {
    cd $EUVIBE_DIR/models
    du -h -d 2 . | awk -F"/" 'NF==3'
}

cmd_pull() {
    mkdir -p $EUVIBE_DIR/models
    singularity run \
        --cwd=$EUVIBE_DIR/models \
        --bind $EUVIBE_DIR/models \
        $EUVIBE_DIR/serve-sandboxes/git_latest.sif \
        lfs clone https://huggingface.co/"$@" "$@"
}

# Timestamped log file for a serve run, e.g. logs/serve-20260924-171500.log
new_log() {
    mkdir -p "$EUVIBE_DIR/logs"
    echo "$EUVIBE_DIR/logs/$1-$(date +%Y%m%d-%H%M%S).log"
}

cmd_serve() {
    export EULER_VIBE_LOGS=$(new_log serve)
    echo "Log: $EULER_VIBE_LOGS"
    sbatch --output=$EULER_VIBE_LOGS --error=$EULER_VIBE_LOGS "$@" $EUVIBE_DIR/serve-dev/dsv4-flash_pro_6000.sbatch
}

serve_local_dir() {
    local dir=$EUVIBE_SERVE_LOCAL
    [[ $dir == */* ]] || dir=$EUVIBE_DIR/serve/$dir
    [[ -f $dir/serve.sh && -f $dir/models.json ]] || {
        echo "Error: $dir must contain serve.sh and models.json" >&2
        exit 1
    }
    echo "$dir"
}

cmd_serve_local() {
    local dir running log
    dir=$(serve_local_dir)
    if ! tmux has-session -t serve_local 2>/dev/null; then
        # Killing the tmux session can leave the container running, still holding the port
        if (exec 3<>/dev/tcp/127.0.0.1/$EUVIBE_PORT) 2>/dev/null; then
            echo "Error: port $EUVIBE_PORT is in use but there is no serve_local session:" >&2
            pgrep -af -- "(llama-server|vllm).*--port $EUVIBE_PORT" >&2 || true
            echo "Stop the stale server first, e.g.: pkill -f -- '(llama-server|vllm).*--port $EUVIBE_PORT'" >&2
            exit 1
        fi
        # tmux sessions inherit the server's environment, possibly from an older
        # Slurm job, so drop its Slurm/GPU vars and pass this job's explicitly;
        # tee keeps the full output, as the tmux scrollback is limited
        local unset_vars=() set_vars=(EUVIBE_DIR="$EUVIBE_DIR" EUVIBE_PORT="$EUVIBE_PORT") v
        for v in $(tmux show-environment -g 2>/dev/null | sed -n 's/^\(SLURM_[A-Z0-9_]*\|CUDA_VISIBLE_DEVICES\)=.*/\1/p'); do
            unset_vars+=(-u "$v")
        done
        for v in TMPDIR CUDA_VISIBLE_DEVICES $(compgen -e | grep '^SLURM_'); do
            [[ -v $v ]] && set_vars+=("$v=${!v}")
        done
        log=$(new_log serve_local)
        tmux new-session -d -s serve_local "$(printf '%q ' env "${unset_vars[@]}" "${set_vars[@]}" \
            "$dir/serve.sh") 2>&1 | tee $(printf '%q' "$log")"
        # Record which setup is served, so pi doesn't pair it with another models.json
        tmux set-environment -t serve_local EUVIBE_SERVE_LOCAL_DIR "$dir"
        echo "Started session serve_local ($(basename "$dir")), log: $log"
    else
        running=$(tmux show-environment -t serve_local EUVIBE_SERVE_LOCAL_DIR 2>/dev/null | sed -n 's/^EUVIBE_SERVE_LOCAL_DIR=//p')
        if [[ $running != "$dir" ]]; then
            echo "Error: session serve_local is serving '${running:-unknown}', not '$dir'" >&2
            echo "Stop it first with: tmux kill-session -t serve_local" >&2
            exit 1
        fi
        echo "Session serve_local is already running ($(basename "$dir"))"
    fi
    echo Attach: tmux attach -t serve_local
    echo Detach: Ctrl-b then d
}

cmd_scancel() {
    EUVIBE_SERVE_JOBID=$(squeue --format="%.18i %.12P %.128j %.8T %.16M %.16l %40R" | awk '$3 ~ /^euler-vibe/ {print $1}')
    echo EUVIBE_SERVE_JOBID is $EUVIBE_SERVE_JOBID
    scancel $EUVIBE_SERVE_JOBID
}

cmd_status() {
    squeue --format="%.18i %.12P %.128j %.8T %.16M %.16l %40R" | awk 'NR==1 || $3 ~ /^euler-vibe/' | column -t --table-right 1,5,6
    echo

    EUVIBE_SERVE_JOBID=$(squeue --format="%.18i %.12P %.128j %.8T %.16M %.16l %40R" | awk '$3 ~ /^euler-vibe/ {print $1}')
    export HEAD_NAME=$(scontrol show hostnames $(squeue -j $EUVIBE_SERVE_JOBID -h -o "%N") | head -n 1)
    export BASE_URL="http://$HEAD_NAME:8000/v1/chat/completions"
    export EUVIBE_LOCAL_PORT=27183
    echo SSH tunnel:
    echo ssh -N -L $EUVIBE_LOCAL_PORT:$HEAD_NAME:$EUVIBE_PORT euler.ethz.ch
    echo 
    echo OpenAI API:
    echo export OPENAI_API_BASE="http://localhost:$EUVIBE_LOCAL_PORT/v1"
    echo export OPENAI_API_KEY=
    echo 
    echo Anthropic API:
    echo export ANTHROPIC_BASE_URL="http://localhost:$EUVIBE_LOCAL_PORT/"
    echo export ANTHROPIC_API_KEY=
    echo export ANTHROPIC_AUTH_TOKEN=
    echo export ANTHROPIC_DEFAULT_OPUS_MODEL=$EUVIBE_MODEL
    echo export ANTHROPIC_DEFAULT_SONNET_MODEL=$EUVIBE_MODEL
    echo export ANTHROPIC_DEFAULT_HAIKU_MODEL=$EUVIBE_MODEL
    echo
    #echo ssh -N -L 8000:$HEAD_NAME:8000 euler.ethz.ch
    # curl -s https://localhost:12345/v1/chat/completions -H "Content-Type: application/json" -d '{"model": "Qwen/Qwen3.6-27B", "messages": [{"role": "user", "content": "Write a haiku about protein-protein interactions"}]}' | jq .

    #echo Asking for haiku:
    #curl -s http://${HEAD_NAME}:8000/v1/chat/completions \
    #    -H "Content-Type: application/json" \
    #    -d '{"model": "Qwen/Qwen3.6-27B-FP8", "messages": [{"role": "user", "content": "Write a haiku about protein-protein interactions"}]}' \
    #    | jq .
    
}

cmd_activate() {
    EUVIBE_SERVE_JOBID=$(squeue --format="%.18i %.12P %.128j %.8T %.16M %.16l %40R" | awk '$3 ~ /^euler-vibe/ {print $1}')
    export HEAD_NAME=$(scontrol show hostnames $(squeue -j $EUVIBE_SERVE_JOBID -h -o "%N") | head -n 1)
    echo export OPENAI_API_BASE="http://localhost:$EUVIBE_LOCAL_PORT/v1"
    echo export OPENAI_API_KEY=
    echo export ANTHROPIC_BASE_URL="http://localhost:$EUVIBE_LOCAL_PORT/"
    echo export ANTHROPIC_API_KEY=
    echo export ANTHROPIC_AUTH_TOKEN=
    echo export ANTHROPIC_DEFAULT_OPUS_MODEL=$EUVIBE_MODEL
    echo export ANTHROPIC_DEFAULT_SONNET_MODEL=$EUVIBE_MODEL
    echo export ANTHROPIC_DEFAULT_HAIKU_MODEL=$EUVIBE_MODEL
    echo pgrep -f \"ssh -f -N -L $EUVIBE_LOCAL_PORT:$HEAD_NAME:$EUVIBE_PORT\" '>' /dev/null '||' ssh -f -N -L $EUVIBE_LOCAL_PORT:$HEAD_NAME:$EUVIBE_PORT euler.ethz.ch
}

cmd_deactivate() {
    echo pkill -f \"ssh -f -N -L $EUVIBE_LOCAL_PORT\"
}

main() {
    local cmd="${1:-}"

    if [[ $# -gt 0 ]]; then
        shift
    fi

    case "$cmd" in
        claude)
            cmd_claude "$@"
            ;;
        pi_llama)
            cmd_pi_llama "$@"
            ;;
        pi_sglang)
            cmd_pi_sglang "$@"
            ;;
        activate)
            cmd_activate "$@"
            ;;
        deactivate)
            cmd_deactivate "$@"
            ;;
        list)
            cmd_list "$@"
            ;;
        pull)
            cmd_pull "$@"
            ;;
        serve)
            cmd_serve "$@"
            ;;
        serve_local)
            cmd_serve_local "$@"
            ;;
        scancel)
            cmd_scancel "$@"
            ;;
        status)
            cmd_status "$@"
            ;;
        -h|--help|"")
            usage
            ;;
        *)
            echo "Error: unknown command '$cmd'" >&2
            echo
            usage
            exit 1
            ;;
    esac
}

main "$@"
