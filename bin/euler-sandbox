#!/usr/bin/env bash
#
# euler-sandbox - run `singularity` in a clean environment using euler-tailored throwaway mounts
#
# The container sees only $PWD (at the same path, also the working directory)
# plus whatever is passed in [args...]. /tmp, the home directory and writes
# outside of bind mounts (--overlay) go to a directory under $TMPDIR that is
# removed on exit. --home <spec> replaces the throwaway home, e.g. to keep a
# persistent one; if its destination is $PWD, $PWD is mounted only as home.
# --no-home mounts no home at all, so $HOME is part of the overlay, e.g. to
# keep it in --overlay-image along with the rest of the container.
#
# Extra bind mounts for a project are read from .euler-vibe/mounts in $PWD,
# see read_project_mounts. --check-mounts only checks that file.
#
# --update-image <image.sif> (re)builds image.sif from image.def next to it if
# the image is missing or was built from a different .def, see update_image.
#
# --overlay-image <file.img> keeps writes outside of bind mounts (e.g. to /usr
# or /opt) in a persistent overlay image instead of the throwaway directory;
# it is created if missing, see create_overlay_image.
#
# Without a singularity subcommand, the script exits after these checks.
#

set -euo pipefail

usage() {
    echo "Usage: $(basename "$0") [--home <src[:dst]> | --no-home] <singularity-subcommand> [args...]" >&2
    echo "       $(basename "$0") [--check-mounts] [--update-image <image.sif>] [--overlay-image <file.img>]" >&2
    echo "  e.g.: $(basename "$0") exec my_container.sif echo hello" >&2
    exit 1
}

# Read extra bind mounts for this project from .euler-vibe/mounts in the
# current directory into the array EUVIBE_MOUNT_ARGS (as --bind <spec> pairs).
# One mount per line in singularity's --bind format, src[:dst[:opts]], e.g.
#     /cluster/work/beltrao/jjaenes/data           # same path inside
#     ~/scratch:/scratch:ro
#     $WORK/26.06_pstQTL::ro                       # empty dst: same path, ro
#     ${DATA}/*.parquet::ro                        # one mount per match
# Blank lines and # comments are ignored. $VAR and ${VAR} are replaced from
# the environment (an unset variable is an error), a leading ~ expands to
# $HOME, a relative src is taken relative to the project directory and an
# empty dst means the same path as src. A src containing *, ? or [ is a glob:
# each match is mounted at its own path (dst must be empty), and no matches
# is fine. Any other src must exist, rather than letting singularity abort.
read_project_mounts() {
    EUVIBE_MOUNT_ARGS=()
    local file="$PWD/.euler-vibe/mounts" line out name src dst opts m
    local var_re='\$\{([A-Za-z_][A-Za-z0-9_]*)\}|\$([A-Za-z_][A-Za-z0-9_]*)'
    local -a matches
    [[ -f "$file" ]] || return 0
    while IFS= read -r line || [[ -n "$line" ]]; do
        line=${line%%#*}
        line=${line#"${line%%[![:space:]]*}"}
        line=${line%"${line##*[![:space:]]}"}
        [[ -n "$line" ]] || continue

        out=
        while [[ "$line" =~ $var_re ]]; do
            name=${BASH_REMATCH[1]:-${BASH_REMATCH[2]}}
            if [[ ! -v $name ]]; then
                echo "$file: \$$name is not set" >&2
                return 1
            fi
            out+=${line%%"${BASH_REMATCH[0]}"*}${!name}
            line=${line#*"${BASH_REMATCH[0]}"}
        done
        line=$out$line

        IFS=: read -r src dst opts <<< "$line"
        [[ "$src" == "~" || "$src" == "~/"* ]] && src=$HOME${src:1}
        [[ "$src" == /* ]] || src=$PWD/$src

        if [[ "$src" == *[*?[]* ]]; then
            if [[ -n "$dst" ]]; then
                echo "$file: glob $src needs an empty dst (src::opts)" >&2
                return 1
            fi
            mapfile -t matches < <(compgen -G "$src" || true)
        elif [[ -e "$src" ]]; then
            matches=("$src")
        else
            echo "$file: $src does not exist" >&2
            return 1
        fi

        for m in "${matches[@]}"; do
            EUVIBE_MOUNT_ARGS+=(--bind "$m:${dst:-$m}${opts:+:$opts}")
        done
    done < "$file"
}

# True if image $1 exists and was built from definition file $2. A .sif keeps
# a copy of the .def it was built from; blank lines and trailing whitespace
# are ignored.
image_matches_def() {
    [[ -f "$1" ]] &&
        diff -q -B -Z <(singularity inspect --deffile "$1" 2>/dev/null) "$2" >/dev/null
}

# (Re)build image.sif from image.def in the same directory if the .def exists
# and the image is missing or was built from a different .def. The build runs
# in the .def's directory (for relative paths in it) and goes to a temporary
# file, so a failed build keeps the old image. A lock on the .def stops two
# launches from building at the same time.
update_image() {
    local sif def
    sif=$(realpath -m "$1")
    def=${sif%.sif}.def
    [[ -f "$def" ]] || return 0
    image_matches_def "$sif" "$def" && return 0

    exec 9<"$def"
    if ! flock -n 9; then
        echo "Waiting for another build of $sif..." >&2
        flock 9
    fi
    if ! image_matches_def "$sif" "$def"; then
        if [[ -f "$sif" ]]; then
            echo "$def has changed, rebuilding $sif" >&2
        else
            echo "Building $sif from $def" >&2
        fi
        build_tmp="$sif.build.$$"
        trap 'rm -f "$build_tmp"' EXIT
        (cd "$(dirname "$def")" && singularity build "$build_tmp" "$def") >&2
        mv -f "$build_tmp" "$sif"
        trap - EXIT
    fi
    exec 9<&-
}

# Create the overlay image $1 if it doesn't exist yet, with a size of
# $EUVIBE_OVERLAY_SIZE: a number of GiB, or a number with an M, G or T suffix
# (default 50G). The image is sparse, so it only takes up the space actually
# written to it. It is created under a temporary name first, so a failed or
# concurrent creation never leaves a half-made image behind.
create_overlay_image() {
    local img=$1 size=${EUVIBE_OVERLAY_SIZE:-50G} mib
    [[ -e "$img" ]] && return 0
    if [[ ! "$size" =~ ^([0-9]+)([MmGgTt]?)$ ]]; then
        echo "EUVIBE_OVERLAY_SIZE=$size: expected a number of GiB, or e.g. 500M, 50G, 1T" >&2
        return 1
    fi
    case ${BASH_REMATCH[2]} in
        M|m) mib=${BASH_REMATCH[1]} ;;
        G|g|"") mib=$((BASH_REMATCH[1] * 1024)) ;;
        T|t) mib=$((BASH_REMATCH[1] * 1024 * 1024)) ;;
    esac

    echo "Creating overlay image $img (${mib} MiB, sparse)" >&2
    mkdir -p "$(dirname "$img")"
    overlay_tmp="$img.create.$$"
    trap 'rm -f "$overlay_tmp"' EXIT
    singularity overlay create --sparse --size "$mib" "$overlay_tmp" >&2
    # upper/ becomes the container's /, and overlay create makes it 0777;
    # tools such as Claude Code refuse a world-writable /. Fix it in place
    # (debugfs edits the ext3 image without mounting it), then check.
    PATH=$PATH:/usr/sbin:/sbin debugfs -w -R 'set_inode_field /upper mode 040755' \
        "$overlay_tmp" 2>/dev/null
    if ! PATH=$PATH:/usr/sbin:/sbin debugfs -R 'stat /upper' "$overlay_tmp" 2>/dev/null |
            grep -q 'Mode: *0755'; then
        echo "could not set the mode of /upper in $overlay_tmp to 0755" >&2
        return 1
    fi
    # If another launch got there first, keep its image
    mv -n "$overlay_tmp" "$img" 2>/dev/null || [[ -e "$img" ]]
    rm -f "$overlay_tmp"
    trap - EXIT
}

home=
no_home=
check_mounts=
image=
overlay_image=
while [[ "${1:-}" == --* ]]; do
    case "$1" in
        --home)
            (( $# >= 2 )) || usage
            home=$2
            shift 2
            ;;
        --home=*)
            home=${1#--home=}
            shift
            ;;
        --no-home)
            no_home=1
            shift
            ;;
        --check-mounts)
            check_mounts=1
            shift
            ;;
        --update-image)
            (( $# >= 2 )) || usage
            image=$2
            shift 2
            ;;
        --update-image=*)
            image=${1#--update-image=}
            shift
            ;;
        --overlay-image)
            (( $# >= 2 )) || usage
            overlay_image=$2
            shift 2
            ;;
        --overlay-image=*)
            overlay_image=${1#--overlay-image=}
            shift
            ;;
        *)
            usage
            ;;
    esac
done

read_project_mounts
if [[ -n "$image" ]]; then
    update_image "$image"
fi
if [[ -n "$overlay_image" ]]; then
    create_overlay_image "$overlay_image"
fi
if (( $# == 0 )) && [[ -n "$check_mounts$image$overlay_image" ]]; then
    exit 0
fi

(( $# >= 1 )) || usage

if (( ${#EUVIBE_MOUNT_ARGS[@]} > 0 )); then
    echo "Extra mounts from .euler-vibe/mounts:" >&2
    for ((i = 1; i < ${#EUVIBE_MOUNT_ARGS[@]}; i += 2)); do
        echo "    ${EUVIBE_MOUNT_ARGS[i]}" >&2
    done
fi

tmpdir="${TMPDIR:-/tmp}"
overlay_dir="${tmpdir%/}/singularity_overlay.$$"

mkdir -p "$overlay_dir"/home "$overlay_dir"/overlay "$overlay_dir"/tmp

cleanup() {
    rm -rf "$overlay_dir"
}
trap cleanup EXIT

opts=(--cleanenv --containall)
if [[ -n "$no_home" ]]; then
    opts+=(--no-home)
else
    home=${home:-$overlay_dir/home}
    opts+=(--home "$home")
fi
opts+=(
    --overlay "${overlay_image:-$overlay_dir/overlay}"
    --bind "$overlay_dir"/tmp:/tmp
)
# --home src is the same as src:src; don't mount $PWD twice if it is home
if [[ "${home#*:}" != "$PWD" ]]; then
    opts+=(--bind "$PWD:$PWD")
fi
opts+=(--cwd "$PWD" "${EUVIBE_MOUNT_ARGS[@]}")

# First argument is the singularity subcommand (exec/run/shell/...);
# --overlay must come after it and before the container/command.
subcmd="$1"
shift

# Not exec: the shell has to outlive singularity for the EXIT trap to remove
# the overlay. The script's exit status is still singularity's.
singularity "$subcmd" "${opts[@]}" "$@"
