#!/usr/bin/env bash
# Create separate/unique directory for /tmp under local scratch using the process id of the batch script
# `--writable-tmpfs` as codex likes to test things by creating temporary files under /tmp
# `--bind $TMPDIR:/tmp` as default from `--writable-tmpfs` is really small
CODEX_EU_BIN=$(realpath $0)
CODEX_EU_DIR=$(dirname $(dirname $CODEX_EU_BIN))
CODEX_EU_HOME=$CODEX_EU_DIR/home
CODEX_EU_IMAGE=$CODEX_EU_DIR/images/codex-eu.sif
CODEX_EU_WORKSPACE_DIR=$(realpath "$1")
CODEX_EU_TMPDIR=$TMPDIR/codex-eu.$$
echo Using image from: $CODEX_EU_IMAGE
echo Mounting /home to: $CODEX_EU_HOME
echo Mounting /tmp  to: $CODEX_EU_TMPDIR
echo Mounting /workspace to: $CODEX_EU_WORKSPACE_DIR
mkdir -p $CODEX_EU_HOME $CODEX_EU_TMPDIR
singularity run \
    --nv \
    --cleanenv \
    --containall \
    --home $CODEX_EU_DIR/home-codex:/home \
    --bind $CODEX_EU_WORKSPACE_DIR:/workspace \
    --bind $CODEX_EU_TMPDIR:/tmp \
    $CODEX_EU_IMAGE
