Bootstrap: docker
From: nvidia/cuda:12.6.3-cudnn-devel-ubuntu24.04

%post
    apt-get update && apt-get install -y --no-install-recommends \
        build-essential \
        ca-certificates \
        cmake \
        curl \
        git \
        make \
        procps \
        python3 \
        python3-dev \
        python3-pip \
        ripgrep \
        unzip \
        && rm -rf /var/lib/apt/lists/*
    npm install -g @anthropic-ai/claude-code

    # Install uv (and uvx) system-wide
    curl -LsSf https://astral.sh/uv/install.sh | env UV_INSTALL_DIR=/usr/local/bin sh

%environment
    # Disables auto-updates, telemetry, error reporting, the /feedback command, release notes, gateway model discovery refreshes, and availability checks, plus feature-flag fetching and the session survey
    export CLAUDE_CODE_DISABLE_NONESSENTIAL_TRAFFIC=1

    # uv can't self-update in a read-only image either
    export UV_NO_MODIFY_PATH=1

    # CUDA runtime paths (host driver libs are injected by --nv at runtime)
    export PATH=/usr/local/cuda/bin:$PATH
    export LD_LIBRARY_PATH=/usr/local/cuda/lib64:${LD_LIBRARY_PATH:-}

%runscript
    exec claude "$@"

%labels
    Description Claude Code CLI in a container for HPC use
        apptainer build claude.sif claude.def
