
Bootstrap: docker
From: ghcr.io/astral-sh/uv:latest
Stage: uv_stage

Bootstrap: docker
From: nvidia/cuda:12.6.0-runtime-ubuntu22.04

%files from uv_stage
    # https://docs.astral.sh/uv/guides/integration/docker/#installing-uv
    # copying the binary from the official distroless Docker image
    /uv /bin/
    /uvx /bin/

%post
    export DEBIAN_FRONTEND=noninteractive
    # build-essential, python3-dev needed for numba compilation such as pooled-ppi
    apt-get update && apt-get install -y --no-install-recommends \
        build-essential \
        ca-certificates \
        curl \
        git \
        python3-dev \
        zstd

    # https://docs.ollama.com/linux
    curl -fsSL https://ollama.com/install.sh | sh

    # https://nodesource.com/products/distributions
    curl -fsSL https://deb.nodesource.com/setup_24.x | bash -
    apt-get update && apt-get install -y --no-install-recommends \
        nodejs

    # apt-get cleanup
    rm -rf /var/lib/apt/lists/* && apt-get clean

    export UV_LINK_MODE=copy
    uv pip install portpicker --system

#%test
    uv --version
    ollama -v
    node -v
    npm -v

%environment
    export UV_LINK_MODE=copy

    # https://stackoverflow.com/questions/10081293/install-npm-into-home-directory-with-distribution-nodejs-package-ubuntu
    # set up a package root in `/home` to hold the Node "global" packages:
    export NPM_PACKAGES="$HOME/.npm-packages"
    export PATH="$NPM_PACKAGES/bin:$PATH"
    mkdir -p "$NPM_PACKAGES"
    echo 'prefix=${NPM_PACKAGES}' >> ~/.npmrc
    export NODE_PATH="$NPM_PACKAGES/lib/node_modules:$NODE_PATH"

%runscript
    # Find open port for ollama server
    export OLLAMA_PORT=`python3 -m portpicker $$`
    export OLLAMA_HOST="127.0.0.1:${OLLAMA_PORT}"

    echo Starting ollama server on ${OLLAMA_HOST}
    ollama serve >> /home/.ollama_serve_adhoc.txt 2>&1 &

    echo Switching to workspace directory
    cd /workspace

    echo Start shell
    exec /bin/bash

%help
    Run sandboxed ollama/pi on euler with the following features/fixes/kludges:
    - Has %runscript that starts the ollama server & then an interactive shell
    - Uses `portpicker` to pick a random open port for ollama to fix `Error: listen tcp 127.0.0.1:11434: bind: address already in use`
    - Neither %runscipt nor %startscript are executed with `singularity shell`
    - Using `--containall` prevents mounting the current working directory in the container (amongst other things)
    - Does not mount home, ollama-eu shows how to run with minimal mounts/settings
    - Container contains ollama, nodejs
    - pi + packages kept outside of container, installed locally
    - Based on `nvidia/cuda:12.6.0-runtime-ubuntu22.04` as used in AlphaFold3 so known to work on euler
    - Official docker image (ollama/ollama) fails with `Error: something went wrong, please see the ollama server logs for details`

    Issues:
    - If Pi can't connect to ollama (suddenly/anymore), can "fix" with `rm -rf home`
    - Better mount for ~/.cache?
