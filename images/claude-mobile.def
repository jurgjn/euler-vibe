Bootstrap: docker
From: ghcr.io/astral-sh/uv:latest
Stage: uv_stage

Bootstrap: docker
From: ubuntu:24.04

%files from uv_stage
    # https://docs.astral.sh/uv/guides/integration/docker/#installing-uv
    # copying the binary from the official distroless Docker image
    /uv /bin/
    /uvx /bin/

%files
    images/patch-happy-force-polling.mjs /opt/patch-happy-force-polling.mjs

%post
    export DEBIAN_FRONTEND=noninteractive

    # build-essential, python3-dev needed for working with python projects (e.g. numba in pooled-ppi)
    # python-is-python3 because tooling keeps looking for it
    apt-get update && apt-get install -y --no-install-recommends \
        bubblewrap \
        build-essential \
        ca-certificates \
        curl \
        git \
        python-is-python3 \
        python3-dev \
        python3-pip \
        python3-numpy \
        time \
        zstd

    # https://nodesource.com/products/distributions
    curl -fsSL https://deb.nodesource.com/setup_24.x | bash -
    apt-get update && apt-get install -y --no-install-recommends \
        nodejs

    # apt-get cleanup
    rm -rf /var/lib/apt/lists/* && apt-get clean

    export UV_LINK_MODE=copy

    # install pnpm via npm (honors HTTP(S)_PROXY) rather than corepack, whose
    # bundled fetch ignores the proxy env vars on proxy-restricted clusters
    npm install -g pnpm@10.11.0

    # Happy 1.1.8 added the electron-based "codium" workspace package; its
    # postinstall downloads the electron binary directly from GitHub (bypassing
    # the proxy) and fails on proxy-restricted clusters. We only build/pack
    # happy-cli, so skip the electron binary download entirely.
    export ELECTRON_SKIP_BINARY_DOWNLOAD=1

    rm -rf /tmp/happy-src /tmp/happy-dist
    git clone https://github.com/slopus/happy.git /tmp/happy-src
    cd /tmp/happy-src
    git checkout b72fd8111a43395e9991cfbdabba36f5a3285e5e
    node /opt/patch-happy-force-polling.mjs /tmp/happy-src
    pnpm install --no-frozen-lockfile
    pnpm --filter happy build
    mkdir -p /tmp/happy-dist
    cd /tmp/happy-src/packages/happy-cli
    pnpm pack --pack-destination /tmp/happy-dist

    npm install -g @anthropic-ai/claude-code@latest /tmp/happy-dist/happy-1.1.8.tgz
    cd /
    rm -rf /tmp/happy-src /tmp/happy-dist /opt/patch-happy-force-polling.mjs
    npm cache clean --force

%test
    uv --version
    claude --version
    command -v happy

%runscript
    cd /workspace
    # --dangerously-skip-permissions because the default sandbox does not run inside apptainer
    # happy (with no subcommand) wraps claude code so the remaining arguments are forwarded to the claude CLI
    happy "$@" --dangerously-skip-permissions
