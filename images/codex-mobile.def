Bootstrap: docker
From: ghcr.io/astral-sh/uv:latest
Stage: uv_stage

Bootstrap: docker
From: ubuntu:24.04

%files from uv_stage
    # https://docs.astral.sh/uv/guides/integration/docker/#installing-uv
    # copying the binary from the official distroless Docker image
    /uv /bin/
    /uvx /bin/

%files
    images/patch-happy-force-polling.mjs /opt/patch-happy-force-polling.mjs

%post
    export DEBIAN_FRONTEND=noninteractive

    # build-essential, python3-dev needed for working with python projects (e.g. numba in pooled-ppi)
    # time used by codex for profiling
    # python-is-python3 because codex keeps looking for it
    apt-get update && apt-get install -y --no-install-recommends \
        bubblewrap \
        build-essential \
        ca-certificates \
        curl \
        git \
        python-is-python3 \
        python3-dev \
        python3-pip \
        python3-numpy \
        time \
        zstd

    # https://nodesource.com/products/distributions
    curl -fsSL https://deb.nodesource.com/setup_24.x | bash -
    apt-get update && apt-get install -y --no-install-recommends \
        nodejs

    # apt-get cleanup
    rm -rf /var/lib/apt/lists/* && apt-get clean

    export UV_LINK_MODE=copy

    corepack enable
    corepack prepare pnpm@10.11.0 --activate

    rm -rf /tmp/happy-src /tmp/happy-dist
    git clone https://github.com/slopus/happy.git /tmp/happy-src
    cd /tmp/happy-src
    git checkout 9452985ec424cac9b9eefd159d087912ae84ff09
    node /opt/patch-happy-force-polling.mjs /tmp/happy-src
    pnpm install --no-frozen-lockfile
    pnpm --filter happy build
    mkdir -p /tmp/happy-dist
    cd /tmp/happy-src/packages/happy-cli
    pnpm pack --pack-destination /tmp/happy-dist

    npm install -g @openai/codex@latest /tmp/happy-dist/happy-1.1.7.tgz
    cd /
    rm -rf /tmp/happy-src /tmp/happy-dist /opt/patch-happy-force-polling.mjs
    npm cache clean --force

%test
    uv --version
    codex --version
    command -v happy

%runscript
    cd /workspace
    # -c use_legacy_landlock=true because the default bubblewrap-based "sandboxing" does not run inside apptainer
    # --dangerously-bypass-approvals-and-sandbox because --full-auto still keeps asking for unnecessary permissions and we're running in apptainer
    # happy codex wraps codex so the remaining arguments are forwarded to the codex CLI
    happy codex "$@" --dangerously-bypass-approvals-and-sandbox -c use_legacy_landlock=true
