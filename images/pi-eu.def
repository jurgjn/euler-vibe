
Bootstrap: docker
From: ghcr.io/astral-sh/uv:0.10.12
Stage: uv_stage

Bootstrap: docker
From: vllm/vllm-openai:latest-cu130

%files from uv_stage
    # https://docs.astral.sh/uv/guides/integration/docker/#installing-uv
    # copying the binary from the official distroless Docker image
    /uv /bin/
    /uvx /bin/

%post
    export DEBIAN_FRONTEND=noninteractive
    # build-essential, python3-dev needed for numba compilation such as pooled-ppi
    apt-get update && apt-get install -y --no-install-recommends \
        build-essential \
        ca-certificates \
        curl \
        git \
        less \
        python-is-python3 \
        python3.13 \
        python3.13-dev \
        zstd

    # nodejs v24 is LTS: https://nodejs.org/en/about/previous-releases 
    # install from NodeSource PPA: https://nodesource.com/products/distributions
    curl -fsSL https://deb.nodesource.com/setup_24.x | bash -
    apt-get update && apt-get install -y --no-install-recommends \
        nodejs

    # apt-get cleanup
    rm -rf /var/lib/apt/lists/* && apt-get clean

    # https://github.com/badlogic/pi-mono/tree/main/packages/coding-agent#quick-start
    npm install -g @mariozechner/pi-coding-agent

    #export UV_LINK_MODE=copy
    #uv pip install portpicker --system
    #uv pip install -U vllm --torch-backend auto --system

%test
    uv --version
    node -v
    npm -v
    pi --version

#%environment
#    export UV_LINK_MODE=copy
#
#    # https://stackoverflow.com/questions/10081293/install-npm-into-home-directory-with-distribution-nodejs-package-ubuntu
#    # set up a package root in `/home` to hold the Node "global" packages:
#    export NPM_PACKAGES="$HOME/.npm-packages"
#    export PATH="$NPM_PACKAGES/bin:$PATH"
#    mkdir -p "$NPM_PACKAGES"
#    echo 'prefix=${NPM_PACKAGES}' >> ~/.npmrc
#    export NODE_PATH="$NPM_PACKAGES/lib/node_modules:$NODE_PATH"

%runscript
    #set -euo pipefail
    echo Starting runscript

    # Write config to serve $EU_VIBE_MODEL
    mkdir -p $HOME/.pi/agent
    cat << EOF > $HOME/.pi/agent/models.json
{
    "providers": {
        "vllm-local": {
            "baseUrl": "http://localhost:8000/v1",
            "api": "openai-completions",
            "apiKey": "todo_generate_me",
            "models": [
                { "id": "$EU_VIBE_MODEL" }
            ]
        }
    }
}
EOF

    # Download model if necessary
    echo Downloading $EU_VIBE_MODEL
    hf download $EU_VIBE_MODEL

    # Start vllm serve with arguments defined in the wrapper script
    EU_VIBE_VLLM_LOGS=/home/vllm_serve_logs_`date +"%y-%m-%d_%H%M%S"`.txt
    echo Starting vllm serve:
    echo logs: $EU_VIBE_VLLM_LOGS
    echo args: $EU_VIBE_VLLM_ARGS
    vllm serve $EU_VIBE_MODEL $EU_VIBE_VLLM_ARGS > $EU_VIBE_VLLM_LOGS 2>&1 &

    echo Waiting for vllm startup to finish
    sleep 120

	EU_VIBE_VLLM_PID=$!
    echo Setting up kill trap for vllm serve with pid $EU_VIBE_VLLM_PID
    trap 'kill -TERM $EU_VIBE_VLLM_PID || true' EXIT TERM INT HUP

    #echo Starting shell
    #exec /bin/bash

    echo Running pi with: "$@"
    pi "$@"

%help
    Run sandboxed ollama/pi on euler with the following features/fixes/kludges:
    - Has %runscript that starts the ollama server & then an interactive shell
    - Uses `portpicker` to pick a random open port for ollama to fix `Error: listen tcp 127.0.0.1:11434: bind: address already in use`
    - Neither %runscipt nor %startscript are executed with `singularity shell`
    - Using `--containall` prevents mounting the current working directory in the container (amongst other things)
    - Does not mount home, ollama-eu shows how to run with minimal mounts/settings
    - Container contains ollama, nodejs
    - pi + packages kept outside of container, installed locally
    - Based on `nvidia/cuda:12.6.0-runtime-ubuntu22.04` as used in AlphaFold3 so known to work on euler
    - Official docker image (ollama/ollama) fails with `Error: something went wrong, please see the ollama server logs for details`

    Issues:
    - If Pi can't connect to ollama (suddenly/anymore), can "fix" with `rm -rf home`
    - Better mount for ~/.cache?
    - Can leave a stray vllm serve process, find & kill with:
        ```
        nvidia-smi --query-compute-apps=pid,process_name,used_memory
        kill ..
        ```


