# Local Codex state when running from the repo root.
.cache/
.codex

# Runtime home directories are mounted into the containers and accumulate
# auth, logs, histories, and other local state that should stay untracked.
home/

# Built container images.
images/*.sif

# Paperpile library downloaded by bin/pget
paperpile/

# Downloaded model weights; only the README with the download commands is tracked
models/*
!models/README.md
