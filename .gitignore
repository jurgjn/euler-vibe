.cache/

# Runtime home directories are mounted into the containers and accumulate
# auth, logs, histories, and other local state that should stay untracked.
home/

# Built container images and overlay images (e.g. .euler-vibe/overlays/*.img)
*.sif
*.img

# Paperpile library downloaded by bin/pget
paperpile/

# Downloaded model weights; only the README with the download commands is tracked
serve-local/models/*
!serve-local/models/README.md

# Experimental serving setups, kept local
serve-local/dev/

# Logs (tmux, sbatch output)
*.log
logs/*

# Runtime caches (torch compile, JIT kernels, flashinfer autotune, rclone, ...)
cache/

# Snakemake state from building images
serve-local/sandboxes/.snakemake/
serve-local/sandboxes/.snakemake-eu/

# NFS placeholders for files deleted while still open
.nfs*
